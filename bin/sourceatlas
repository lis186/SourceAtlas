# Main entry point
main() {
    local command="${1:-}"
    
    case "$command" in
        version|--version|-v)
            show_version
            ;;
        help|--help|-h|"")
            show_help
            ;;
        init)
            shift
            cmd_init "$@"
            ;;
        scan)
            shift
            cmd_scan "$@"
            ;;
        symbols)
            shift
            cmd_symbols "$@"
            ;;
        stats)
            shift
            cmd_stats "$@"
            ;;
        manifest)
            shift
            cmd_manifest "$@"
            ;;
        shard)
            shift
            cmd_shard "$@"
            ;;
        delta)
            shift
            cmd_delta "$@"
            ;;
        query)
            shift
            cmd_query "$@"
            ;;
        segment)
            shift
            cmd_segment "$@"
            ;;
        export-dsl)
            shift
            cmd_export_dsl "$@"
            ;;
        clean)
            shift
            cmd_clean "$@"
            ;;
        run)
            shift
            cmd_run "$@"
            ;;
        verify)
            shift
            cmd_verify "$@"
            ;;
        *)
            echo "Error: Unknown command: $command" >&2
            echo "Run '${PROG_NAME} help' for usage information." >&2
            exit 1
            ;;
    esac
}

# Run main function
main "$@"