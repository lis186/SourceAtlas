#!/usr/bin/env bash

# SourceAtlas - Lightweight code indexing tool for AI agents
# Main CLI entry point

set -e

# Version information
readonly VERSION="0.1.0"
readonly SCHEMA_VERSION="1"
readonly PROG_NAME="$(basename "$0")"

# Script directory
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${SCRIPT_DIR}/../lib"

# Load core library if it exists
if [[ -f "${LIB_DIR}/core.sh" ]]; then
    source "${LIB_DIR}/core.sh"
fi

# Show version information
show_version() {
    cat <<EOF
SourceAtlas - Code Indexing Tool
Version: ${VERSION}
Schema Version: ${SCHEMA_VERSION}
EOF
}

# Show help message
show_help() {
    cat <<EOF
Usage: ${PROG_NAME} <command> [options]

SourceAtlas creates lightweight code indexes to help AI agents navigate large codebases.

Commands:
  version         Show version information
  init            Initialize configuration in current directory
  scan            Scan directory and generate index
  symbols         Generate symbol table from index
  stats           Generate statistics from index
  manifest        Create or update manifest file
  shard           Split index into shards
  delta           Perform incremental update
  query           Search the index
  segment         Extract code segments
  export-dsl      Export index in DSL format
  clean           Remove generated files
  run             Run full indexing pipeline
  verify          Verify index consistency
  help            Show this help message

Options:
  --help          Show help for a specific command
  --version       Show version information

Examples:
  ${PROG_NAME} init
  ${PROG_NAME} scan --root . --out .sourceatlas/
  ${PROG_NAME} run

For more information, see: https://github.com/sourceatlas/sourceatlas
EOF
}

# Command: init
cmd_init() {
    local force=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f)
                force=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} init [options]

Initialize SourceAtlas configuration in the current directory.

Options:
  --force, -f     Force reinitialization (overwrite existing config)
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} init
  ${PROG_NAME} init --force
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} init --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local atlas_dir=".sourceatlas"
    
    # Check if already initialized
    if [[ -d "${atlas_dir}" ]] && [[ "${force}" = false ]]; then
        echo "SourceAtlas already initialized in this directory."
        echo "Use '${PROG_NAME} init --force' to reinitialize."
        exit 0
    fi
    
    # Create .sourceatlas directory
    mkdir -p "${atlas_dir}"
    
    # Create default config file
    cat > "${atlas_dir}/config.toml" <<'EOF'
# SourceAtlas Configuration

[general]
# Repository name (auto-detected if not set)
repo = ""

# Schema version
schema_version = 1

[languages]
# Languages to index
enabled = ["swift", "kotlin", "objc", "ruby", "python", "shell", "java", "javascript", "typescript"]

# Language-specific settings
[languages.swift]
extensions = [".swift"]
symbols = ["class", "struct", "enum", "protocol", "extension", "actor", "func"]

[languages.kotlin]
extensions = [".kt", ".kts"]
symbols = ["class", "object", "interface", "fun", "data class", "sealed class"]

[languages.objc]
extensions = [".m", ".h", ".mm"]
symbols = ["@interface", "@implementation", "@protocol", "@property"]

[languages.ruby]
extensions = [".rb", ".rake", ".gemspec"]
symbols = ["class", "module", "def"]

[languages.python]
extensions = [".py", ".pyi"]
symbols = ["class", "def", "async def"]

[languages.shell]
extensions = [".sh", ".bash", ".zsh"]
symbols = ["function"]

[output]
# Output directory
directory = ".sourceatlas"

# Compression
compress = true
compression = "gzip"

[limits]
# Shard limits
shard_max_bytes = 2097152  # 2MB
shard_max_records = 10000

# Progressive retrieval limits
max_shards_per_query = 3
max_files_per_query = 20
max_lines_per_segment = 400
segment_padding = 10

# Performance limits
max_file_size_bytes = 10485760  # 10MB
max_threads = 4
EOF
    
    # Create exclude patterns file
    cat > "${atlas_dir}/exclude_patterns.txt" <<'EOF'
# Exclude patterns for SourceAtlas
# One pattern per line, supports glob patterns

# Build directories
**/build/**
**/.gradle/**
**/dist/**
**/out/**
**/target/**

# Version control
**/.git/**
**/.svn/**
**/.hg/**

# Dependencies
**/node_modules/**
**/Pods/**
**/vendor/**
**/PrebuiltFrameworks/**
**/.bundle/**

# IDE and editor files
**/.idea/**
**/.vscode/**
**/*.xcworkspace/**
**/*.xcodeproj/**
**/.DS_Store
**/.settings/**
**/.classpath
**/.project

# Temporary files
**/tmp/**
**/temp/**
**/cache/**
**/*.tmp
**/*.temp
**/*.cache

# Sensitive files
*.mobileprovision
*.cer
*.p12
*.p8
*.key
*.pem
*.pfx
*.keystore
*.jks

# Binary files
*.jar
*.war
*.ear
*.class
*.dll
*.exe
*.so
*.dylib
*.a
*.o

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Images and media
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.mp4
*.mp3
*.wav

# Documentation builds
**/docs/_build/**
**/site/**
EOF
    
    # Create .gitignore for atlas directory
    cat > "${atlas_dir}/.gitignore" <<'EOF'
# SourceAtlas generated files
*.jsonl
*.jsonl.gz
*.jsonl.zst
*.tsv
*.tsv.gz
*.tsv.zst
*.json
!config.toml
!exclude_patterns.txt
EOF
    
    echo "SourceAtlas initialized successfully in ${atlas_dir}/"
    echo ""
    echo "Next steps:"
    echo "  1. Review and customize ${atlas_dir}/config.toml"
    echo "  2. Review and customize ${atlas_dir}/exclude_patterns.txt"
    echo "  3. Run '${PROG_NAME} scan' to generate the index"
}

# Command: scan
cmd_scan() {
    local root_dir="."
    local out_dir=".sourceatlas"
    local debug_mode=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)
                root_dir="$2"
                shift 2
                ;;
            --out)
                out_dir="$2"
                shift 2
                ;;
            --debug)
                debug_mode=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} scan [options]

Scan directory and generate index.

Options:
  --root DIR      Root directory to scan (default: current directory)
  --out DIR       Output directory (default: .sourceatlas)
  --debug         Enable debug mode to show detailed processing information
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} scan
  ${PROG_NAME} scan --root src --out .sourceatlas
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} scan --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    # Check if initialized
    if [[ ! -f ".sourceatlas/config.toml" ]] && [[ "$out_dir" == ".sourceatlas" ]]; then
        echo "SourceAtlas not initialized. Run '${PROG_NAME} init' first." >&2
        exit 1
    fi
    
    # Create output directory
    mkdir -p "$out_dir"
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local exclude_file=".sourceatlas/exclude_patterns.txt"
    local repo_name="$(basename "$(pwd)")"
    
    # Clear existing index
    > "$index_file"
    
    echo "Scanning directory: $root_dir"
    echo "Output: $index_file"
    
    # First pass: count total files to process
    echo "Calculating total files..."
    local total_files=0
    local files_to_process=""
    
    while IFS= read -r file; do
        # Skip if file matches exclude patterns
        if is_excluded "$file" "$exclude_file"; then
            continue
        fi
        
        # Skip hidden files and directories
        if [[ "$file" == *"/."* ]]; then
            continue
        fi
        
        # Skip the atlas directory itself
        if [[ "$file" == *"/.sourceatlas/"* ]]; then
            continue
        fi
        
        ((total_files++))
        files_to_process="${files_to_process}${file}"$'\n'
    done < <(find "$root_dir" -type f -name "*" 2>/dev/null)
    
    echo "Total files to process: $total_files"
    echo "----------------------------------------"
    
    # Check if there are files to process
    if [[ $total_files -eq 0 ]]; then
        echo "No files to process."
        echo "Index created: $index_file"
        return 0
    fi
    
    local file_count=0
    local start_time=$(date +%s)
    local total_processing_time=0
    
    # Process files with progress tracking
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        
        local file_start_time=$(date +%s%N)
        # Skip if file matches exclude patterns
        if is_excluded "$file" "$exclude_file"; then
            continue
        fi
        
        # Skip hidden files and directories
        if [[ "$file" == *"/."* ]]; then
            continue
        fi
        
        # Skip the atlas directory itself
        if [[ "$file" == *"/.sourceatlas/"* ]]; then
            continue
        fi
        
        local file_name="$(basename "$file")"
        local ext="$(get_extension "$file")"
        local lang="$(get_language "$ext")"
        
        # Debug output
        if [[ "$debug_mode" == "true" ]]; then
            echo "Processing: $file (lang: $lang, ext: $ext)" >&2
        fi
        
        # Skip binary and unknown files
        if [[ "$lang" == "unknown" ]]; then
            case "$ext" in
                .png|.jpg|.jpeg|.gif|.svg|.ico|.pdf|.zip|.tar|.gz|.exe|.dll|.so|.dylib|.a|.o|.class|.jar)
                    if [[ "$debug_mode" == "true" ]]; then
                        echo "  Skipping binary file: $file" >&2
                    fi
                    continue
                    ;;
            esac
        fi
        
        local size_bytes="$(get_file_size "$file")"
        local loc="$(count_lines "$file")"
        local content_hash="$(calculate_hash "$file")"
        local role="$(detect_role "$file")"
        local imports="$(extract_imports "$file" "$lang")"
        local symbols_json="$(extract_symbols "$file" "$lang")"
        local summary="$(generate_summary "$file" "$lang" "$role")"
        
        # Debug output for extracted data
        if [[ "$debug_mode" == "true" ]]; then
            echo "  size_bytes: $size_bytes, loc: $loc, role: $role" >&2
            echo "  symbols_json: $symbols_json" >&2
        fi
        
        # Create JSON object
        local json_obj=$(cat <<EOF
{
  "repo": "$(json_escape "$repo_name")",
  "path": "$(json_escape "$file")",
  "file_name": "$(json_escape "$file_name")",
  "ext": "$(json_escape "$ext")",
  "lang": "$(json_escape "$lang")",
  "size_bytes": $size_bytes,
  "loc": $loc,
  "roles": ["$(json_escape "$role")"],
  "summary": "$(json_escape "$summary")",
  "imports": ["$(json_escape "$imports")"],
  "symbols": $symbols_json,
  "importance_score": 0.5,
  "content_hash": "$(json_escape "$content_hash")"
}
EOF
        )
        
        # Write JSON object as single line
        if ! echo "$json_obj" | jq -c . >> "$index_file" 2>/dev/null; then
            echo "ERROR: Failed to parse JSON for file: $file" >&2
            if [[ "$debug_mode" == "true" ]]; then
                echo "Raw JSON:" >&2
                echo "$json_obj" >&2
                echo "Testing with jq:" >&2
                echo "$json_obj" | jq . >&2 || true
            fi
            exit 1
        fi
        
        if [[ "$debug_mode" == "true" ]]; then
            echo "  Successfully processed: $file" >&2
        fi
        
        ((file_count++))
        
        # Calculate progress and timing
        local file_end_time=$(date +%s%N)
        local file_processing_time=$(( (file_end_time - file_start_time) / 1000000 )) # Convert to milliseconds
        total_processing_time=$((total_processing_time + file_processing_time))
        
        local current_time=$(date +%s)
        local elapsed_time=$((current_time - start_time))
        local percentage=$((file_count * 100 / total_files))
        
        # Calculate estimated time remaining
        local avg_time_per_file=$((total_processing_time / file_count))
        local remaining_files=$((total_files - file_count))
        local estimated_remaining=$((remaining_files * avg_time_per_file / 1000)) # Convert to seconds
        
        # Format elapsed time
        local elapsed_min=$((elapsed_time / 60))
        local elapsed_sec=$((elapsed_time % 60))
        
        # Format estimated remaining time
        local remaining_min=$((estimated_remaining / 60))
        local remaining_sec=$((estimated_remaining % 60))
        
        # Progress display
        if [[ "$debug_mode" != "true" ]]; then
            printf "\r[%3d%%] Processing %d/%d files | File: %-50s | Time: %dms | Elapsed: %02d:%02d | ETA: %02d:%02d" \
                "$percentage" "$file_count" "$total_files" \
                "$(basename "$file" | cut -c1-50)" \
                "$file_processing_time" \
                "$elapsed_min" "$elapsed_sec" \
                "$remaining_min" "$remaining_sec"
        fi
    done <<< "$files_to_process"
    
    # Clear the progress line and show final results
    if [[ "$debug_mode" != "true" ]]; then
        printf "\r%-120s\r" " "  # Clear the line
    fi
    
    local final_time=$(date +%s)
    local total_elapsed=$((final_time - start_time))
    local total_min=$((total_elapsed / 60))
    local total_sec=$((total_elapsed % 60))
    
    echo "----------------------------------------"
    echo "Scan completed!"
    echo "  Indexed files: $file_count"
    echo "  Total time: ${total_min}m ${total_sec}s"
    if [[ $file_count -gt 0 ]]; then
        echo "  Average time per file: $((total_processing_time / file_count))ms"
    fi
    echo "  Index created: $index_file"
}

# Command: symbols
cmd_symbols() {
    local out_dir=".sourceatlas"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} symbols [options]

Generate reverse symbol table from index.

Options:
  --out DIR       Output directory (default: .sourceatlas)
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} symbols
  ${PROG_NAME} symbols --out .sourceatlas
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} symbols --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local symbols_file="${out_dir}/sourceatlas.symbols.tsv"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Create output directory
    mkdir -p "$out_dir"
    
    echo "Generating symbol table from: $index_file"
    echo "Output: $symbols_file"
    
    # Count total lines first
    local total_lines=$(wc -l < "$index_file")
    echo "Processing $total_lines files for symbols..."
    
    # Write TSV header
    echo -e "symbol\tkind\trepo\tpath\tline_start\tline_end" > "$symbols_file"
    
    # Process each line of the index
    local symbol_count=0
    local line_count=0
    local start_time=$(date +%s)
    
    while IFS= read -r line; do
        # Skip empty lines
        [[ -z "$line" ]] && continue
        
        ((line_count++))
        
        # Parse JSON line
        local repo=$(echo "$line" | jq -r '.repo // ""')
        local path=$(echo "$line" | jq -r '.path // ""')
        local symbols_array=$(echo "$line" | jq -c '.symbols // []')
        
        # Skip if no symbols
        if [[ "$symbols_array" == "[]" ]] || [[ "$symbols_array" == "null" ]]; then
            # Still show progress even for files without symbols
            if [[ $((line_count % 50)) -eq 0 ]] || [[ $line_count -eq $total_lines ]]; then
                local percentage=$((line_count * 100 / total_lines))
                printf "\r[%3d%%] Processing symbols: %d/%d files | Found %d symbols" \
                    "$percentage" "$line_count" "$total_lines" "$symbol_count"
            fi
            continue
        fi
        
        # Extract each symbol and write to TSV
        echo "$symbols_array" | jq -r --arg repo "$repo" --arg path "$path" '.[] | select(.name != null and .name != "") | [.name, .kind, $repo, $path, .line_start, .line_end] | @tsv' >> "$symbols_file"
        
        local symbols_in_file=$(echo "$symbols_array" | jq -r '. | length')
        symbol_count=$((symbol_count + symbols_in_file))
        
        # Update progress every 50 files or at the end
        if [[ $((line_count % 50)) -eq 0 ]] || [[ $line_count -eq $total_lines ]]; then
            local percentage=$((line_count * 100 / total_lines))
            printf "\r[%3d%%] Processing symbols: %d/%d files | Found %d symbols" \
                "$percentage" "$line_count" "$total_lines" "$symbol_count"
        fi
        
    done < "$index_file"
    
    # Clear progress line
    printf "\r%-80s\r" " "
    
    # Sort the symbols file (skip header)
    {
        head -n 1 "$symbols_file"
        tail -n +2 "$symbols_file" | sort
    } > "${symbols_file}.tmp" && mv "${symbols_file}.tmp" "$symbols_file"
    
    echo "Generated $symbol_count symbols"
    echo "Symbol table created: $symbols_file"
}

# Command: stats
cmd_stats() {
    local out_dir=".sourceatlas"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} stats [options]

Generate statistics from index.

Options:
  --out DIR       Output directory (default: .sourceatlas)
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} stats
  ${PROG_NAME} stats --out .sourceatlas
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} stats --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local stats_file="${out_dir}/sourceatlas.stats.json"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Create output directory
    mkdir -p "$out_dir"
    
    echo "Generating statistics from: $index_file"
    echo "Output: $stats_file"
    
    # Count total lines first
    local total_index_lines=$(wc -l < "$index_file")
    echo "Processing $total_index_lines files for statistics..."
    
    # Initialize counters
    local total_files=0
    local total_lines=0
    local total_bytes=0
    local total_symbols=0
    local max_lines=0
    local min_lines=999999
    local max_bytes=0
    local largest_file=""
    
    # Language and role tracking (using simple variables)
    local lang_list=""
    local role_list=""
    local symbol_kind_list=""
    
    local repo_name=""
    local lines_array=()
    local bytes_array=()
    local start_time=$(date +%s)
    
    # Process each line of the index
    while IFS= read -r line; do
        # Skip empty lines
        [[ -z "$line" ]] && continue
        
        ((total_files++))
        
        # Parse JSON line
        local repo=$(echo "$line" | jq -r '.repo // ""')
        local path=$(echo "$line" | jq -r '.path // ""')
        local lang=$(echo "$line" | jq -r '.lang // ""')
        local loc=$(echo "$line" | jq -r '.loc // 0')
        local size_bytes=$(echo "$line" | jq -r '.size_bytes // 0')
        local roles=$(echo "$line" | jq -r '.roles[]? // "unknown"')
        local symbols_array=$(echo "$line" | jq -c '.symbols // []')
        
        # Update progress every 100 files or at the end
        if [[ $((total_files % 100)) -eq 0 ]] || [[ $total_files -eq $total_index_lines ]]; then
            local percentage=$((total_files * 100 / total_index_lines))
            printf "\r[%3d%%] Calculating statistics: %d/%d files | %d LOC | %d symbols" \
                "$percentage" "$total_files" "$total_index_lines" "$total_lines" "$total_symbols"
        fi
        
        # Set repo name from first entry
        if [[ -z "$repo_name" ]] && [[ -n "$repo" ]]; then
            repo_name="$repo"
        fi
        
        # Update counters
        ((total_files++))
        total_lines=$((total_lines + loc))
        total_bytes=$((total_bytes + size_bytes))
        
        # Track arrays for median calculation
        lines_array+=("$loc")
        bytes_array+=("$size_bytes")
        
        # Update min/max
        if [[ $loc -gt $max_lines ]]; then
            max_lines=$loc
        fi
        if [[ $loc -lt $min_lines ]] && [[ $loc -gt 0 ]]; then
            min_lines=$loc
        fi
        if [[ $size_bytes -gt $max_bytes ]]; then
            max_bytes=$size_bytes
            largest_file="$path"
        fi
        
        # Language distribution
        if [[ -n "$lang" ]]; then
            if [[ "$lang_list" != *"$lang"* ]]; then
                lang_list="${lang_list} $lang"
            fi
        fi
        
        # Role distribution
        if [[ -n "$roles" ]]; then
            if [[ "$role_list" != *"$roles"* ]]; then
                role_list="${role_list} $roles"
            fi
        fi
        
        # Symbol counting
        local symbol_count=$(echo "$symbols_array" | jq -r 'length')
        total_symbols=$((total_symbols + symbol_count))
        
        # Symbol kind distribution
        local kinds=$(echo "$symbols_array" | jq -r '.[].kind // "unknown"' | tr '\n' ' ')
        for kind in $kinds; do
            if [[ -n "$kind" ]] && [[ "$symbol_kind_list" != *"$kind"* ]]; then
                symbol_kind_list="${symbol_kind_list} $kind"
            fi
        done
        
    done < "$index_file"
    
    # Clear progress line
    printf "\r%-80s\r" " "
    
    # Calculate averages
    local avg_lines=0
    local avg_bytes=0
    if [[ $total_files -gt 0 ]]; then
        avg_lines=$((total_lines / total_files))
        avg_bytes=$((total_bytes / total_files))
    fi
    
    # Calculate median lines (simplified)
    local median_lines=0
    if [[ ${#lines_array[@]} -gt 0 ]]; then
        IFS=$'\n' sorted_lines=($(sort -n <<<"${lines_array[*]}"))
        local mid_idx=$(( ${#sorted_lines[@]} / 2 ))
        median_lines=${sorted_lines[$mid_idx]}
    fi
    
    # Reset min if no files
    if [[ $min_lines -eq 999999 ]]; then
        min_lines=0
    fi
    
    # Generate timestamp
    local timestamp
    if command -v date >/dev/null 2>&1; then
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    else
        timestamp="unknown"
    fi
    
    # Create stats JSON
    cat > "$stats_file" <<EOF
{
  "generated_at": "$timestamp",
  "repository": {
    "name": "$repo_name",
    "schema_version": $SCHEMA_VERSION
  },
  "files": {
    "total_count": $total_files,
    "indexed_at": "$timestamp"
  },
  "languages": {
EOF
    
    # Create language distribution using jq for accuracy
    local lang_json_array=""
    if [[ -n "$lang_list" ]]; then
        for lang in $lang_list; do
            if [[ -n "$lang" ]]; then
                local count=$(cat "$index_file" | jq -r --arg lang "$lang" 'select(.lang == $lang)' | wc -l | tr -d ' ')
                if [[ -n "$lang_json_array" ]]; then
                    lang_json_array="${lang_json_array}, "
                fi
                lang_json_array="${lang_json_array}\"$lang\": $count"
            fi
        done
    fi
    
    # Create role distribution using jq for accuracy  
    local role_json_array=""
    if [[ -n "$role_list" ]]; then
        for role in $role_list; do
            if [[ -n "$role" ]]; then
                local count=$(cat "$index_file" | jq -r --arg role "$role" 'select(.roles[]? == $role)' | wc -l | tr -d ' ')
                if [[ -n "$role_json_array" ]]; then
                    role_json_array="${role_json_array}, "
                fi
                role_json_array="${role_json_array}\"$role\": $count"
            fi
        done
    fi
    
    # Create symbol kind distribution using jq for accuracy
    local kind_json_array=""
    if [[ -n "$symbol_kind_list" ]]; then
        for kind in $symbol_kind_list; do
            if [[ -n "$kind" ]]; then
                local count=$(cat "$index_file" | jq -r --arg kind "$kind" '.symbols[]? | select(.kind == $kind)' | wc -l | tr -d ' ')
                if [[ -n "$kind_json_array" ]]; then
                    kind_json_array="${kind_json_array}, "
                fi
                kind_json_array="${kind_json_array}\"$kind\": $count"
            fi
        done
    fi
    
    # Complete the JSON structure
    cat >> "$stats_file" <<EOF
    ${lang_json_array:-}
  },
  "roles": {
    ${role_json_array:-}
  },
  "lines_of_code": {
    "total": $total_lines,
    "average": $avg_lines,
    "median": $median_lines,
    "max": $max_lines,
    "min": $min_lines
  },
  "file_sizes": {
    "total_bytes": $total_bytes,
    "average_bytes": $avg_bytes,
    "largest_file": "$largest_file",
    "max_bytes": $max_bytes
  },
  "symbols": {
    "total_count": $total_symbols,
    "by_kind": {
      ${kind_json_array:-}
    }
  }
}
EOF
    
    echo "Generated statistics for $total_files files"
    echo "Total lines of code: $total_lines"
    echo "Total symbols: $total_symbols"
    echo "Statistics created: $stats_file"
}

# Command: manifest
cmd_manifest() {
    local out_dir=".sourceatlas"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} manifest [options]

Create or update manifest file.

Options:
  --out DIR       Output directory (default: .sourceatlas)
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} manifest
  ${PROG_NAME} manifest --out .sourceatlas
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} manifest --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local manifest_file="${out_dir}/sourceatlas.manifest.json"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Create output directory
    mkdir -p "$out_dir"
    
    echo "Generating manifest from: $index_file"
    echo "Output: $manifest_file"
    
    # Get repository info
    local repo_name="$(basename "$(pwd)")"
    local root_path="$(pwd)"
    
    # Calculate index file stats
    local index_size=$(get_file_size "$index_file")
    local index_hash=$(calculate_hash "$index_file")
    local index_lines=$(count_lines "$index_file")
    
    echo "Processing $index_lines files for manifest..."
    
    # Analyze index content
    local total_files=0
    local total_size_bytes=0
    local language_list=""
    local start_time=$(date +%s)
    
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        ((total_files++))
        
        local size_bytes=$(echo "$line" | jq -r '.size_bytes // 0')
        local lang=$(echo "$line" | jq -r '.lang // ""')
        
        total_size_bytes=$((total_size_bytes + size_bytes))
        
        if [[ -n "$lang" ]] && [[ "$language_list" != *"$lang"* ]]; then
            language_list="${language_list} $lang"
        fi
        
        # Update progress every 100 files or at the end
        if [[ $((total_files % 100)) -eq 0 ]] || [[ $total_files -eq $index_lines ]]; then
            local percentage=$((total_files * 100 / index_lines))
            printf "\r[%3d%%] Building manifest: %d/%d files | Total size: %d bytes" \
                "$percentage" "$total_files" "$index_lines" "$total_size_bytes"
        fi
    done < "$index_file"
    
    # Clear progress line
    printf "\r%-80s\r" " "
    
    # Generate language counts
    local lang_json=""
    local first_lang=true
    for lang in $language_list; do
        if [[ -n "$lang" ]]; then
            local count=$(cat "$index_file" | jq -r --arg lang "$lang" 'select(.lang == $lang)' | wc -l | tr -d ' ')
            if [[ "$first_lang" == true ]]; then
                first_lang=false
            else
                lang_json="${lang_json}, "
            fi
            lang_json="${lang_json}\"$lang\": $count"
        fi
    done
    
    # Check for additional output files
    local symbols_file="${out_dir}/sourceatlas.symbols.tsv"
    local stats_file="${out_dir}/sourceatlas.stats.json"
    
    local symbols_json=""
    if [[ -f "$symbols_file" ]]; then
        local symbols_size=$(get_file_size "$symbols_file")
        local symbols_hash=$(calculate_hash "$symbols_file")
        symbols_json=",
    \"symbols\": {
      \"path\": \"$(basename "$symbols_file")\",
      \"size_bytes\": $symbols_size,
      \"hash\": \"$symbols_hash\",
      \"format\": \"tsv\"
    }"
    fi
    
    local stats_json=""
    if [[ -f "$stats_file" ]]; then
        local stats_size=$(get_file_size "$stats_file")
        local stats_hash=$(calculate_hash "$stats_file")
        stats_json=",
    \"stats\": {
      \"path\": \"$(basename "$stats_file")\",
      \"size_bytes\": $stats_size,
      \"hash\": \"$stats_hash\",
      \"format\": \"json\"
    }"
    fi
    
    # Generate timestamp
    local timestamp
    if command -v date >/dev/null 2>&1; then
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    else
        timestamp="unknown"
    fi
    
    # Create manifest JSON
    cat > "$manifest_file" <<EOF
{
  "version": "1.0.0",
  "schema_version": $SCHEMA_VERSION,
  "generated_at": "$timestamp",
  "repository": {
    "name": "$repo_name",
    "root_path": "$root_path"
  },
  "files": {
    "total_count": $total_files,
    "total_size_bytes": $total_size_bytes,
    "languages": {
      ${lang_json:-}
    }
  },
  "outputs": {
    "index": {
      "path": "$(basename "$index_file")",
      "size_bytes": $index_size,
      "records": $index_lines,
      "hash": "$index_hash",
      "format": "jsonl"
    }${symbols_json:-}${stats_json:-}
  }
}
EOF
    
    echo "Generated manifest for $total_files files"
    echo "Total size: $total_size_bytes bytes"
    echo "Languages: $(echo $language_list | wc -w | tr -d ' ')"
    echo "Manifest created: $manifest_file"
}

# Command: shard
cmd_shard() {
    local out_dir=".sourceatlas"
    local shard_strategy="directory"  # directory, language, or auto
    local max_size_bytes=2097152      # 2MB default
    local max_records=10000           # 10k records default
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --by-directory)
                shard_strategy="directory"
                shift
                ;;
            --by-language)
                shard_strategy="language"
                shift
                ;;
            --max-size)
                max_size_bytes="$2"
                shift 2
                ;;
            --max-records)
                max_records="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} shard [options]

Split index into shards by directory or language.

Options:
  --out DIR           Output directory (default: .sourceatlas)
  --by-directory      Shard by directory structure (default)
  --by-language       Shard by programming language
  --max-size BYTES    Maximum shard size in bytes (default: 2097152)
  --max-records NUM   Maximum records per shard (default: 10000)
  --help, -h          Show this help message

Examples:
  ${PROG_NAME} shard
  ${PROG_NAME} shard --by-language --max-records 5000
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} shard --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local manifest_file="${out_dir}/sourceatlas.manifest.json"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Create output directory
    mkdir -p "$out_dir"
    
    echo "Sharding index: $index_file"
    echo "Strategy: $shard_strategy"
    echo "Max size: $max_size_bytes bytes"
    echo "Max records: $max_records"
    
    # Remove existing shard files
    rm -f "${out_dir}"/sourceatlas.index.*.jsonl
    
    # Determine sharding strategy
    case "$shard_strategy" in
        directory)
            shard_by_directory "$index_file" "$out_dir" "$max_size_bytes" "$max_records"
            ;;
        language)
            shard_by_language "$index_file" "$out_dir" "$max_size_bytes" "$max_records"
            ;;
        *)
            echo "Error: Unknown sharding strategy: $shard_strategy" >&2
            exit 1
            ;;
    esac
    
    # Update manifest with shard information
    update_manifest_with_shards "$out_dir"
    
    local shard_count=$(ls "${out_dir}"/sourceatlas.index.*.jsonl 2>/dev/null | wc -l)
    echo "Created $shard_count shard files"
    echo "Manifest updated: $manifest_file"
}

# Shard by directory structure
shard_by_directory() {
    local index_file="$1"
    local out_dir="$2"
    local max_size="$3"
    local max_records="$4"
    
    # Group files by top-level directory
    local current_shard=""
    local current_records=0
    local current_size=0
    local shard_counter=1
    
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        local path=$(echo "$line" | jq -r '.path // ""')
        local size_bytes=$(echo "$line" | jq -r '.size_bytes // 0')
        
        # Extract top-level directory
        local top_dir=$(echo "$path" | cut -d'/' -f2)
        [[ -z "$top_dir" ]] && top_dir="root"
        
        # Sanitize directory name for filename
        local shard_name=$(echo "$top_dir" | tr '/' '_' | tr -cd '[:alnum:]_-')
        [[ -z "$shard_name" ]] && shard_name="misc"
        
        local target_shard="${out_dir}/sourceatlas.index.${shard_name}.jsonl"
        
        # Check if we need to start a new shard due to size/record limits
        if [[ "$current_shard" != "$target_shard" ]] || 
           [[ $current_records -ge $max_records ]] || 
           [[ $current_size -ge $max_size ]]; then
            
            # If hitting limits, create numbered shard
            if [[ $current_records -ge $max_records ]] || [[ $current_size -ge $max_size ]]; then
                target_shard="${out_dir}/sourceatlas.index.${shard_name}-${shard_counter}.jsonl"
                ((shard_counter++))
            fi
            
            current_shard="$target_shard"
            current_records=0
            current_size=0
        fi
        
        # Write to shard
        echo "$line" >> "$current_shard"
        ((current_records++))
        current_size=$((current_size + size_bytes))
        
    done < "$index_file"
}

# Shard by programming language
shard_by_language() {
    local index_file="$1"
    local out_dir="$2"
    local max_size="$3"
    local max_records="$4"
    
    # Group files by language (without associative arrays for compatibility)
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        local lang=$(echo "$line" | jq -r '.lang // "unknown"')
        local size_bytes=$(echo "$line" | jq -r '.size_bytes // 0')
        
        # Sanitize language name for filename
        local shard_name=$(echo "$lang" | tr -cd '[:alnum:]_-')
        [[ -z "$shard_name" ]] && shard_name="unknown"
        
        local target_shard="${out_dir}/sourceatlas.index.${shard_name}.jsonl"
        
        # Check limits and create numbered shards if needed
        if [[ -f "$target_shard" ]]; then
            local current_records=$(count_lines "$target_shard")
            local current_size=$(get_file_size "$target_shard")
            
            if [[ $current_records -ge $max_records ]] || [[ $current_size -ge $max_size ]]; then
                local counter=1
                while [[ -f "${out_dir}/sourceatlas.index.${shard_name}-${counter}.jsonl" ]]; do
                    ((counter++))
                done
                target_shard="${out_dir}/sourceatlas.index.${shard_name}-${counter}.jsonl"
            fi
        fi
        
        # Write to shard
        echo "$line" >> "$target_shard"
        
    done < "$index_file"
}

# Update manifest with shard information
update_manifest_with_shards() {
    local out_dir="$1"
    local manifest_file="${out_dir}/sourceatlas.manifest.json"
    
    # Get repository info
    local repo_name="$(basename "$(pwd)")"
    local timestamp
    if command -v date >/dev/null 2>&1; then
        timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    else
        timestamp="unknown"
    fi
    
    # Create shards array
    local shards_json="["
    local first_shard=true
    
    for shard_file in "${out_dir}"/sourceatlas.index.*.jsonl; do
        [[ ! -f "$shard_file" ]] && continue
        
        local shard_name=$(basename "$shard_file" .jsonl | sed 's/sourceatlas\.index\.//')
        local shard_size=$(get_file_size "$shard_file")
        local shard_hash=$(calculate_hash "$shard_file")
        local shard_records=$(count_lines "$shard_file")
        
        # Determine languages in this shard
        local langs=$(cat "$shard_file" | jq -r '.lang // "unknown"' | sort -u | tr '\n' ',' | sed 's/,$//')
        local langs_json=""
        if [[ -n "$langs" ]]; then
            IFS=',' read -ra lang_array <<< "$langs"
            local first_lang=true
            for lang in "${lang_array[@]}"; do
                if [[ "$first_lang" == true ]]; then
                    first_lang=false
                else
                    langs_json="${langs_json}, "
                fi
                langs_json="${langs_json}\"$lang\""
            done
        fi
        
        if [[ "$first_shard" == true ]]; then
            first_shard=false
        else
            shards_json="${shards_json}, "
        fi
        
        shards_json="${shards_json}{
      \"id\": \"$shard_name\",
      \"path\": \"$(basename "$shard_file")\",
      \"files\": $shard_records,
      \"size_bytes\": $shard_size,
      \"lang\": [$langs_json],
      \"hash\": \"$shard_hash\"
    }"
    done
    
    shards_json="${shards_json}]"
    
    # Create manifest
    cat > "$manifest_file" <<EOF
{
  "version": "1.0.0",
  "schema_version": $SCHEMA_VERSION,
  "generated_at": "$timestamp",
  "repository": {
    "name": "$repo_name"
  },
  "shards": $shards_json,
  "shard_rules": {
    "by_dir": [
      {"prefix": "ios/", "description": "iOS source files"},
      {"prefix": "android/", "description": "Android source files"},
      {"prefix": "scripts/", "description": "Build and utility scripts"},
      {"prefix": "config/", "description": "Configuration files"}
    ]
  }
}
EOF
}

# Command: delta
cmd_delta() {
    local out_dir=".sourceatlas"
    local apply_changes=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --apply)
                apply_changes=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} delta [options]

Detect incremental changes and optionally rebuild affected files.

Options:
  --out DIR       Output directory (default: .sourceatlas)
  --apply         Apply changes and rebuild affected files
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} delta
  ${PROG_NAME} delta --apply
  ${PROG_NAME} delta --out custom_output
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} delta --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local delta_report="${out_dir}/delta.report.json"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Create output directory
    mkdir -p "$out_dir"
    
    echo "Detecting changes..."
    
    # Track changes
    local added_files=()
    local modified_files=()
    local removed_files=()
    local change_count=0
    
    # Get list of current files from index
    local indexed_files=$(mktemp)
    jq -r '.path' "$index_file" | sort > "$indexed_files"
    
    # Get list of current source files (using same logic as scan command)
    local current_files=$(mktemp)
    local exclude_file="${out_dir}/exclude_patterns.txt"
    [[ -f "$exclude_file" ]] || exclude_file="/dev/null"
    
    find . -type f -name "*" 2>/dev/null | while read -r file; do
        # Skip if file matches exclude patterns
        if is_excluded "$file" "$exclude_file"; then
            continue
        fi
        
        # Skip hidden files and directories
        if [[ "$file" == *"/."* ]]; then
            continue
        fi
        
        # Skip the atlas directory itself
        if [[ "$file" == *"/.sourceatlas/"* ]]; then
            continue
        fi
        
        local ext="$(get_extension "$file")"
        local lang="$(get_language "$ext")"
        
        # Skip binary and unknown files (same logic as scan)
        if [[ "$lang" == "unknown" ]]; then
            case "$ext" in
                .png|.jpg|.jpeg|.gif|.svg|.ico|.pdf|.zip|.tar|.gz|.exe|.dll|.so|.dylib|.a|.o|.class|.jar)
                    continue
                    ;;
            esac
        fi
        
        echo "$file"
    done | sort > "$current_files"
    
    # Find added files
    while IFS= read -r file; do
        if ! grep -Fxq "$file" "$indexed_files"; then
            added_files+=("$file")
            ((change_count++))
        fi
    done < "$current_files"
    
    # Find removed files
    while IFS= read -r file; do
        if ! grep -Fxq "$file" "$current_files"; then
            removed_files+=("$file")
            ((change_count++))
        fi
    done < "$indexed_files"
    
    # Find modified files (check mtime and size)
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        local path=$(echo "$line" | jq -r '.path // ""')
        local indexed_size=$(echo "$line" | jq -r '.size_bytes // 0')
        local indexed_hash=$(echo "$line" | jq -r '.content_hash // ""')
        
        if [[ -f "$path" ]]; then
            local current_size=$(stat -f%z "$path" 2>/dev/null || stat -c%s "$path" 2>/dev/null || echo "0")
            
            # Check if size changed or file is newer than a reasonable time
            if [[ "$current_size" != "$indexed_size" ]]; then
                # Verify with content hash if available
                local current_hash=""
                if command -v sha256sum >/dev/null; then
                    current_hash=$(sha256sum "$path" | cut -d' ' -f1)
                elif command -v shasum >/dev/null; then
                    current_hash=$(shasum -a 256 "$path" | cut -d' ' -f1)
                elif command -v openssl >/dev/null; then
                    current_hash=$(openssl dgst -sha256 -hex "$path" | cut -d' ' -f2)
                fi
                
                if [[ -n "$current_hash" ]] && [[ "$current_hash" != "$indexed_hash" ]]; then
                    modified_files+=("$path")
                    ((change_count++))
                elif [[ -z "$indexed_hash" ]]; then
                    # No hash available, assume modified if size changed
                    modified_files+=("$path")
                    ((change_count++))
                fi
            fi
        fi
    done < "$index_file"
    
    # Generate report
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    cat > "$delta_report" <<EOF
{
  "timestamp": "$timestamp",
  "changes": [
EOF
    
    local first_entry=true
    
    # Add added files to report
    for file in "${added_files[@]}"; do
        if [[ "$first_entry" == true ]]; then
            first_entry=false
        else
            echo "," >> "$delta_report"
        fi
        cat >> "$delta_report" <<EOF
    {
      "type": "added",
      "path": "$file"
    }
EOF
    done
    
    # Add modified files to report
    for file in "${modified_files[@]}"; do
        if [[ "$first_entry" == true ]]; then
            first_entry=false
        else
            echo "," >> "$delta_report"
        fi
        cat >> "$delta_report" <<EOF
    {
      "type": "modified",
      "path": "$file"
    }
EOF
    done
    
    # Add removed files to report
    for file in "${removed_files[@]}"; do
        if [[ "$first_entry" == true ]]; then
            first_entry=false
        else
            echo "," >> "$delta_report"
        fi
        cat >> "$delta_report" <<EOF
    {
      "type": "removed",
      "path": "$file"
    }
EOF
    done
    
    # Close changes array and add summary
    cat >> "$delta_report" <<EOF
  ],
  "summary": {
    "added_count": ${#added_files[@]},
    "modified_count": ${#modified_files[@]},
    "removed_count": ${#removed_files[@]},
    "total_changes": $change_count
  }
}
EOF
    
    # Clean up temp files
    rm -f "$indexed_files" "$current_files"
    
    # Report results
    if [[ $change_count -eq 0 ]]; then
        echo "No changes detected"
        echo "Delta report: $delta_report"
        return 0
    fi
    
    echo "Changes detected:"
    [[ ${#added_files[@]} -gt 0 ]] && echo "  Added: ${#added_files[@]} files"
    [[ ${#modified_files[@]} -gt 0 ]] && echo "  Modified: ${#modified_files[@]} files"
    [[ ${#removed_files[@]} -gt 0 ]] && echo "  Removed: ${#removed_files[@]} files"
    
    # Show some examples
    if [[ ${#added_files[@]} -gt 0 ]]; then
        echo "  Examples of added files:"
        for i in "${!added_files[@]}"; do
            [[ $i -ge 3 ]] && break
            echo "    + ${added_files[$i]}"
        done
    fi
    
    if [[ ${#modified_files[@]} -gt 0 ]]; then
        echo "  Examples of modified files:"
        for i in "${!modified_files[@]}"; do
            [[ $i -ge 3 ]] && break
            echo "    ~ ${modified_files[$i]}"
        done
    fi
    
    if [[ ${#removed_files[@]} -gt 0 ]]; then
        echo "  Examples of removed files:"
        for i in "${!removed_files[@]}"; do
            [[ $i -ge 3 ]] && break
            echo "    - ${removed_files[$i]}"
        done
    fi
    
    # Check for large changes (>30% threshold)
    local total_indexed=$(count_lines "$index_file")
    local change_percent=0
    if [[ $total_indexed -gt 0 ]]; then
        change_percent=$((change_count * 100 / total_indexed))
    fi
    
    if [[ $change_percent -gt 30 ]]; then
        echo ""
        echo "Warning: Large number of changes detected ($change_percent%)"
        echo "Consider running full rebuild: ${PROG_NAME} run"
    fi
    
    echo ""
    echo "Delta report: $delta_report"
    
    # Apply changes if requested
    if [[ "$apply_changes" == true ]]; then
        echo ""
        echo "Applying changes and rebuilding affected files..."
        
        # For now, just rebuild everything since we don't have partial rebuild
        # In a full implementation, we would only rebuild affected shards
        cmd_scan --out "$out_dir"
        cmd_symbols --out "$out_dir"
        cmd_stats --out "$out_dir"
        cmd_manifest --out "$out_dir"
        
        echo "Changes applied successfully"
    fi
}

# Command: query
cmd_query() {
    local out_dir=".sourceatlas"
    local query_pattern=""
    local search_type="content"  # content, symbol, path, lang, role
    local use_regex=false
    local ignore_case=false
    local limit=50
    local output_format="text"  # text, json
    local verbose=false
    local show_scores=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --type)
                search_type="$2"
                shift 2
                ;;
            --regex|-r)
                use_regex=true
                shift
                ;;
            --ignore-case|-i)
                ignore_case=true
                shift
                ;;
            --limit|-l)
                limit="$2"
                shift 2
                ;;
            --format|-f)
                output_format="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --scores|-s)
                show_scores=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} query [options] PATTERN

Search for files, symbols, or content in the index.

Arguments:
  PATTERN         Search pattern (string or regex)

Options:
  --out DIR       Output directory (default: .sourceatlas)
  --type TYPE     Search type: content, symbol, path, lang, role (default: content)
  --regex, -r     Use regex pattern matching
  --ignore-case, -i   Case insensitive search
  --limit NUM     Limit results (default: 50)
  --format FORMAT Output format: text, json (default: text)
  --verbose, -v   Show detailed information
  --scores, -s    Show relevance scores
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} query "AppDelegate"
  ${PROG_NAME} query --type symbol "class.*View"
  ${PROG_NAME} query --type path "ios/"
  ${PROG_NAME} query --type lang "swift"
  ${PROG_NAME} query --regex --ignore-case "app.*delegate"
EOF
                exit 0
                ;;
            -*)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} query --help' for usage." >&2
                exit 1
                ;;
            *)
                query_pattern="$1"
                shift
                ;;
        esac
    done
    
    if [[ -z "$query_pattern" ]]; then
        echo "Error: Search pattern is required" >&2
        echo "Run '${PROG_NAME} query --help' for usage." >&2
        exit 1
    fi
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local symbols_file="${out_dir}/sourceatlas.symbols.tsv"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    local results=()
    local match_count=0
    local start_time=$(date +%s.%N)
    
    # Show search status
    echo "Searching for pattern: $query_pattern" >&2
    echo "Search type: $search_type" >&2
    [[ "$ignore_case" == true ]] && echo "Case insensitive: enabled" >&2
    [[ "$use_regex" == true ]] && echo "Regex mode: enabled" >&2
    echo "----------------------------------------" >&2
    
    # Prepare grep options
    local grep_opts=""
    [[ "$ignore_case" == true ]] && grep_opts+="-i "
    [[ "$use_regex" != true ]] && grep_opts+="-F "
    
    # Search based on type
    case "$search_type" in
        symbol)
            # Search in symbols file if available
            if [[ -f "$symbols_file" ]]; then
                echo "Using symbol table: $(basename "$symbols_file")" >&2
                # Skip header line and parse TSV format: symbol	kind	repo	path	line_start	line_end
                # Note: kind field is often empty, so repo becomes kind, path becomes repo, etc.
                # Use grep to filter symbol table efficiently
                local grep_cmd
                if [[ "$use_regex" == true ]]; then
                    if [[ "$ignore_case" == true ]]; then
                        grep_cmd="grep -i"
                    else
                        grep_cmd="grep"
                    fi
                    grep_cmd="$grep_cmd '$query_pattern'"
                else
                    if [[ "$ignore_case" == true ]]; then
                        grep_cmd="grep -Fi"
                    else
                        grep_cmd="grep -F"
                    fi
                    grep_cmd="$grep_cmd '$query_pattern'"
                fi
                
                while IFS=$'\t' read -r symbol_name kind repo file_path line_start line_end; do
                    # Handle empty kind field by shifting variables
                    if [[ -z "$line_end" ]]; then
                        line_end="$line_start"
                        line_start="$file_path"  
                        file_path="$repo"
                        repo="$kind"
                        kind=""
                    fi
                    [[ "$match_count" -ge "$limit" ]] && break
                    
                    local score=100
                    results+=("$file_path:$line_start:$symbol_name ($kind):$score")
                    ((match_count++))
                done < <(tail -n +2 "$symbols_file" | eval "$grep_cmd")
            else
                echo "Symbol table not found, using index fallback..." >&2
                # Fallback to searching in index symbols
                while IFS= read -r line; do
                    [[ "$match_count" -ge "$limit" ]] && break
                    [[ -z "$line" ]] && continue
                    
                    local path=$(echo "$line" | jq -r '.path // ""')
                    local symbols_array=$(echo "$line" | jq -c '.symbols // []')
                    
                    # Use process substitution to avoid subshell issue
                    while IFS=':' read -r symbol_name line_num kind; do
                        [[ "$match_count" -ge "$limit" ]] && break
                        
                        local match=false
                        if [[ "$use_regex" == true ]]; then
                            if [[ "$ignore_case" == true ]]; then
                                echo "$symbol_name" | grep -qi "$query_pattern" && match=true
                            else
                                echo "$symbol_name" | grep -q "$query_pattern" && match=true
                            fi
                        else
                            if [[ "$ignore_case" == true ]]; then
                                echo "$symbol_name" | grep -Fqi "$query_pattern" && match=true
                            else
                                echo "$symbol_name" | grep -Fq "$query_pattern" && match=true
                            fi
                        fi
                        
                        if [[ "$match" == true ]]; then
                            local score=100
                            results+=("$path:$line_num:$symbol_name ($kind):$score")
                            ((match_count++))
                        fi
                    done < <(echo "$symbols_array" | jq -r '.[] | "\(.name):\(.line_start):\(.kind)"')
                done < "$index_file"
            fi
            ;;
        path)
            # Search file paths
            while IFS= read -r line; do
                [[ "$match_count" -ge "$limit" ]] && break
                [[ -z "$line" ]] && continue
                
                local path=$(echo "$line" | jq -r '.path // ""')
                
                local match=false
                if [[ "$use_regex" == true ]]; then
                    if [[ "$ignore_case" == true ]]; then
                        echo "$path" | grep -qi "$query_pattern" && match=true
                    else
                        echo "$path" | grep -q "$query_pattern" && match=true
                    fi
                else
                    if [[ "$ignore_case" == true ]]; then
                        echo "$path" | grep -Fqi "$query_pattern" && match=true
                    else
                        echo "$path" | grep -Fq "$query_pattern" && match=true
                    fi
                fi
                
                if [[ "$match" == true ]]; then
                    local score=100
                    local lang=$(echo "$line" | jq -r '.lang // ""')
                    local loc=$(echo "$line" | jq -r '.loc // 0')
                    results+=("$path:1:Path match ($lang, $loc lines):$score")
                    ((match_count++))
                fi
            done < "$index_file"
            ;;
        lang)
            # Search by language
            while IFS= read -r line; do
                [[ "$match_count" -ge "$limit" ]] && break
                [[ -z "$line" ]] && continue
                
                local path=$(echo "$line" | jq -r '.path // ""')
                local lang=$(echo "$line" | jq -r '.lang // ""')
                
                local match=false
                if [[ "$use_regex" == true ]]; then
                    if [[ "$ignore_case" == true ]]; then
                        echo "$lang" | grep -qi "$query_pattern" && match=true
                    else
                        echo "$lang" | grep -q "$query_pattern" && match=true
                    fi
                else
                    if [[ "$ignore_case" == true ]]; then
                        echo "$lang" | grep -Fqi "$query_pattern" && match=true
                    else
                        echo "$lang" | grep -Fq "$query_pattern" && match=true
                    fi
                fi
                
                if [[ "$match" == true ]]; then
                    local score=100
                    local loc=$(echo "$line" | jq -r '.loc // 0')
                    results+=("$path:1:Language: $lang ($loc lines):$score")
                    ((match_count++))
                fi
            done < "$index_file"
            ;;
        role)
            # Search by role
            while IFS= read -r line; do
                [[ "$match_count" -ge "$limit" ]] && break
                [[ -z "$line" ]] && continue
                
                local path=$(echo "$line" | jq -r '.path // ""')
                local roles_array=$(echo "$line" | jq -r '.roles[]? // ""')
                
                local match=false
                for role in $roles_array; do
                    if [[ "$use_regex" == true ]]; then
                        if [[ "$ignore_case" == true ]]; then
                            echo "$role" | grep -qi "$query_pattern" && match=true && break
                        else
                            echo "$role" | grep -q "$query_pattern" && match=true && break
                        fi
                    else
                        if [[ "$ignore_case" == true ]]; then
                            echo "$role" | grep -Fqi "$query_pattern" && match=true && break
                        else
                            echo "$role" | grep -Fq "$query_pattern" && match=true && break
                        fi
                    fi
                done
                
                if [[ "$match" == true ]]; then
                    local score=100
                    local lang=$(echo "$line" | jq -r '.lang // ""')
                    results+=("$path:1:Role match ($lang):$score")
                    ((match_count++))
                fi
            done < "$index_file"
            ;;
        content|*)
            # Search content (summary, imports, or full content)
            while IFS= read -r line; do
                [[ "$match_count" -ge "$limit" ]] && break
                [[ -z "$line" ]] && continue
                
                local path=$(echo "$line" | jq -r '.path // ""')
                local summary=$(echo "$line" | jq -r '.summary // ""')
                local imports=$(echo "$line" | jq -r '.imports // ""')
                
                local match=false
                local match_context=""
                
                # Check summary
                if [[ "$use_regex" == true ]]; then
                    if [[ "$ignore_case" == true ]]; then
                        echo "$summary" | grep -qi "$query_pattern" && match=true && match_context="Summary"
                    else
                        echo "$summary" | grep -q "$query_pattern" && match=true && match_context="Summary"
                    fi
                else
                    if [[ "$ignore_case" == true ]]; then
                        echo "$summary" | grep -Fqi "$query_pattern" && match=true && match_context="Summary"
                    else
                        echo "$summary" | grep -Fq "$query_pattern" && match=true && match_context="Summary"
                    fi
                fi
                
                # Check imports if no match yet
                if [[ "$match" != true ]]; then
                    if [[ "$use_regex" == true ]]; then
                        if [[ "$ignore_case" == true ]]; then
                            echo "$imports" | grep -qi "$query_pattern" && match=true && match_context="Imports"
                        else
                            echo "$imports" | grep -q "$query_pattern" && match=true && match_context="Imports"
                        fi
                    else
                        if [[ "$ignore_case" == true ]]; then
                            echo "$imports" | grep -Fqi "$query_pattern" && match=true && match_context="Imports"
                        else
                            echo "$imports" | grep -Fq "$query_pattern" && match=true && match_context="Imports"
                        fi
                    fi
                fi
                
                # Check path as fallback
                if [[ "$match" != true ]]; then
                    if [[ "$use_regex" == true ]]; then
                        if [[ "$ignore_case" == true ]]; then
                            echo "$path" | grep -qi "$query_pattern" && match=true && match_context="Path"
                        else
                            echo "$path" | grep -q "$query_pattern" && match=true && match_context="Path"
                        fi
                    else
                        if [[ "$ignore_case" == true ]]; then
                            echo "$path" | grep -Fqi "$query_pattern" && match=true && match_context="Path"
                        else
                            echo "$path" | grep -Fq "$query_pattern" && match=true && match_context="Path"
                        fi
                    fi
                fi
                
                if [[ "$match" == true ]]; then
                    local score=80
                    local line_num=1  # Default to line 1 instead of 0 for file-level matches
                    [[ "$match_context" == "Summary" ]] && score=100
                    [[ "$match_context" == "Path" ]] && score=60
                    local lang=$(echo "$line" | jq -r '.lang // ""')
                    results+=("$path:$line_num:Content match in $match_context ($lang):$score")
                    ((match_count++))
                fi
            done < "$index_file"
            ;;
    esac
    
    # Calculate execution time
    local end_time=$(date +%s.%N)
    local execution_time=$(echo "$end_time - $start_time" | bc -l | xargs printf "%.3f")
    
    # Output results
    if [[ ${#results[@]} -eq 0 ]]; then
        echo "No matches found for pattern: $query_pattern"
        echo "Search completed in ${execution_time}s" >&2
        return 0
    fi
    
    if [[ "$output_format" == "json" ]]; then
        echo "{"
        echo "  \"query\": \"$query_pattern\","
        echo "  \"type\": \"$search_type\","
        echo "  \"total_matches\": ${#results[@]},"
        echo "  \"execution_time\": \"${execution_time}s\","
        echo "  \"results\": ["
        
        for i in "${!results[@]}"; do
            local result="${results[$i]}"
            local path=$(echo "$result" | cut -d':' -f1)
            local line_num=$(echo "$result" | cut -d':' -f2)
            local description=$(echo "$result" | cut -d':' -f3)
            local score=$(echo "$result" | cut -d':' -f4)
            
            echo -n "    {"
            echo -n "\"path\": \"$path\", \"line\": $line_num, \"description\": \"$description\", \"score\": $score"
            if [[ $i -lt $((${#results[@]} - 1)) ]]; then
                echo "},"
            else
                echo "}"
            fi
        done
        
        echo "  ]"
        echo "}"
    else
        # Text format
        echo "Found ${#results[@]} matches for pattern: $query_pattern"
        echo ""
        
        for result in "${results[@]}"; do
            local path=$(echo "$result" | cut -d':' -f1)
            local line_num=$(echo "$result" | cut -d':' -f2)
            local description=$(echo "$result" | cut -d':' -f3)
            local score=$(echo "$result" | cut -d':' -f4)
            
            if [[ "$verbose" == true ]]; then
                if [[ "$show_scores" == true ]]; then
                    echo "$path:$line_num - $description (Score: $score)"
                else
                    echo "$path:$line_num - $description"
                fi
                
                # Show additional file details
                local file_info=$(jq -r "select(.path == \"$path\") | \"  Language: \" + (.lang // \"unknown\") + \", Lines: \" + (.loc // 0 | tostring) + \", Role: \" + (.roles[]? // \"unknown\" | tostring)" "$index_file" | head -1)
                [[ -n "$file_info" ]] && echo "$file_info"
                echo ""
            else
                if [[ "$show_scores" == true ]]; then
                    echo "$path:$line_num - $description (Score: $score)"
                else
                    echo "$path:$line_num"
                fi
            fi
        done
        
        echo "" >&2
        echo "Search completed in ${execution_time}s" >&2
    fi
}

# Command: segment
cmd_segment() {
    local out_dir=".sourceatlas"
    local file_path=""
    local start_line=1
    local end_line=1
    local pad_lines=0
    local max_lines=400
    local show_line_numbers=false
    local show_context=false
    local show_symbols=false
    local output_format="text"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --pad)
                pad_lines="$2"
                shift 2
                ;;
            --max-lines)
                max_lines="$2"
                shift 2
                ;;
            --line-numbers|-n)
                show_line_numbers=true
                shift
                ;;
            --context|-c)
                show_context=true
                shift
                ;;
            --symbol-context)
                show_symbols=true
                shift
                ;;
            --format|-f)
                output_format="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} segment [options] FILE START END

Extract code segment with optional padding and context.

Arguments:
  FILE            File path to extract from
  START           Start line number
  END             End line number

Options:
  --out DIR       Output directory (default: .sourceatlas)
  --pad NUM       Add NUM lines of padding around segment (default: 0)
  --max-lines NUM Maximum lines to return (default: 400)
  --line-numbers, -n  Show line numbers
  --context, -c   Show file context information
  --symbol-context    Show symbol information for the range
  --format FORMAT Output format: text, json (default: text)
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} segment file.swift 10 20
  ${PROG_NAME} segment --pad 5 --line-numbers file.kt 15 25
  ${PROG_NAME} segment --format json --context file.py 100 150
EOF
                exit 0
                ;;
            -*)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} segment --help' for usage." >&2
                exit 1
                ;;
            *)
                if [[ -z "$file_path" ]]; then
                    file_path="$1"
                elif [[ -z "$start_line" ]] || [[ "$start_line" == "1" ]]; then
                    start_line="$1"
                elif [[ -z "$end_line" ]] || [[ "$end_line" == "1" ]]; then
                    end_line="$1"
                fi
                shift
                ;;
        esac
    done
    
    # Validate arguments
    if [[ -z "$file_path" ]]; then
        echo "Error: File path is required" >&2
        echo "Run '${PROG_NAME} segment --help' for usage." >&2
        exit 1
    fi
    
    if [[ -z "$start_line" ]] || [[ -z "$end_line" ]]; then
        echo "Error: Start and end line numbers are required" >&2
        echo "Run '${PROG_NAME} segment --help' for usage." >&2
        exit 1
    fi
    
    # Validate line numbers
    if ! [[ "$start_line" =~ ^[0-9]+$ ]] || ! [[ "$end_line" =~ ^[0-9]+$ ]]; then
        echo "Error: Line numbers must be positive integers" >&2
        exit 1
    fi
    
    # Swap if reverse range
    if [[ $start_line -gt $end_line ]]; then
        local temp=$start_line
        start_line=$end_line
        end_line=$temp
    fi
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Check if file exists
    if [[ ! -f "$file_path" ]]; then
        echo "Error: File not found: $file_path" >&2
        exit 1
    fi
    
    # Calculate actual range with padding
    local actual_start=$((start_line - pad_lines))
    local actual_end=$((end_line + pad_lines))
    
    # Ensure we don't go below line 1
    [[ $actual_start -lt 1 ]] && actual_start=1
    
    # Get total line count of file
    local total_lines=$(wc -l < "$file_path")
    [[ $actual_end -gt $total_lines ]] && actual_end=$total_lines
    
    # Calculate segment size and apply max_lines limit
    local segment_size=$((actual_end - actual_start + 1))
    if [[ $segment_size -gt $max_lines ]]; then
        actual_end=$((actual_start + max_lines - 1))
        segment_size=$max_lines
    fi
    
    # Extract the segment
    local segment_content=""
    if [[ $actual_start -eq $actual_end ]]; then
        # Single line
        segment_content=$(sed -n "${actual_start}p" "$file_path")
    else
        # Range of lines
        segment_content=$(sed -n "${actual_start},${actual_end}p" "$file_path")
    fi
    
    # Get file info from index if available
    local file_lang="unknown"
    local file_role="unknown"
    local symbols_info=""
    
    # For now, skip index lookup to isolate the issue
    # TODO: Fix jq parsing for JSONL file
    
    # Output based on format
    if [[ "$output_format" == "json" ]]; then
        cat <<EOF
{
  "file": "$file_path",
  "language": "${file_lang:-unknown}",
  "role": "${file_role:-unknown}",
  "requested_range": {
    "start": $start_line,
    "end": $end_line
  },
  "actual_range": {
    "start": $actual_start,
    "end": $actual_end
  },
  "padding": $pad_lines,
  "total_lines": $segment_size,
  "content": $(printf '%s' "$segment_content" | jq -R -s .)
EOF
        
        if [[ "$show_symbols" == true && -n "$symbols_info" ]]; then
            echo '  ,"symbols": ['
            echo "$symbols_info" | while IFS= read -r symbol; do
                [[ -n "$symbol" ]] && echo "    \"$symbol\","
            done | sed '$ s/,$//'
            echo '  ]'
        fi
        
        echo "}"
    else
        # Text format
        if [[ "$show_context" == true ]]; then
            echo "File: $file_path"
            echo "Language: ${file_lang:-unknown}"
            echo "Role: ${file_role:-unknown}"
            echo "Lines: $actual_start-$actual_end (requested: $start_line-$end_line)"
            if [[ $pad_lines -gt 0 ]]; then
                echo "Padding: $pad_lines lines"
            fi
            if [[ $segment_size -ge $max_lines ]]; then
                echo "Note: Output limited to $max_lines lines"
            fi
            echo ""
        fi
        
        if [[ "$show_symbols" == true && -n "$symbols_info" ]]; then
            echo "Symbols in range:"
            echo "$symbols_info" | while IFS= read -r symbol; do
                [[ -n "$symbol" ]] && echo "  - $symbol"
            done
            echo ""
        fi
        
        # Output content with optional line numbers
        if [[ "$show_line_numbers" == true ]]; then
            echo "$segment_content" | nl -ba -nln -v"$actual_start" | sed 's/^[ ]*\([0-9]*\)/\1:/'
        else
            echo "$segment_content"
        fi
    fi
}

# Command: export-dsl
cmd_export_dsl() {
    local out_dir=".sourceatlas"
    local output_file=""
    local output_format="stdout"
    local symbols_only=false
    local max_lines=1000
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --format)
                output_format="$2"
                shift 2
                ;;
            --symbols-only)
                symbols_only=true
                shift
                ;;
            --max-lines)
                max_lines="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} export-dsl [options]

Export index to low-token DSL format for efficient AI agent consumption.

Options:
  --out DIR         Output directory (default: .sourceatlas)
  --format TYPE     Output format: stdout, file (default: stdout)
  --symbols-only    Export only symbol information
  --max-lines NUM   Maximum lines to output (default: 1000)
  --help, -h        Show this help message

DSL Format:
  F:P=path,L=lang,R=role,LOC=lines,SZ=bytes
  SYM:N=name,K=kind,LN=line,V=visibility

Examples:
  ${PROG_NAME} export-dsl
  ${PROG_NAME} export-dsl --format file
  ${PROG_NAME} export-dsl --symbols-only --max-lines 500
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} export-dsl --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local symbols_file="${out_dir}/sourceatlas.symbols.tsv"
    
    # Check if index file exists
    if [[ ! -f "$index_file" ]]; then
        echo "Error: Index file not found: $index_file" >&2
        echo "Run '${PROG_NAME} scan' first to generate the index." >&2
        exit 1
    fi
    
    # Determine output destination
    local output_dest=""
    if [[ "$output_format" == "file" ]]; then
        output_dest="${out_dir}/sourceatlas.dsl"
        output_file="$output_dest"
        > "$output_dest"  # Clear file
    fi
    
    local line_count=0
    
    # Function to output line
    output_line() {
        local line="$1"
        [[ $line_count -ge $max_lines ]] && return
        
        if [[ -n "$output_dest" ]]; then
            echo "$line" >> "$output_dest"
        else
            printf '%s\n' "$line"
        fi
        ((line_count++))
    }
    
    # Export file information
    if [[ "$symbols_only" != true ]]; then
        # Process each line of the index file
        while IFS= read -r line; do
            [[ $line_count -ge $max_lines ]] && break
            [[ -z "$line" ]] && continue
            
            # Parse JSON and convert to DSL
            local path=$(echo "$line" | jq -r '.path // ""')
            local lang=$(echo "$line" | jq -r '.lang // ""')
            local role=$(echo "$line" | jq -r '.roles[]? // ""' | head -1)
            local loc=$(echo "$line" | jq -r '.loc // 0')
            local size_bytes=$(echo "$line" | jq -r '.size_bytes // 0')
            local summary=$(echo "$line" | jq -r '.summary // ""')
            local imports=$(echo "$line" | jq -r '.imports // ""')
            
            # Build DSL line with abbreviated fields
            local dsl_line="F:P=$path"
            [[ -n "$lang" ]] && dsl_line+=",L=$lang"
            [[ -n "$role" ]] && dsl_line+=",R=$role"
            [[ "$loc" -gt 0 ]] && dsl_line+=",LOC=$loc"
            [[ "$size_bytes" -gt 0 ]] && dsl_line+=",SZ=$size_bytes"
            
            # Add summary if compact enough
            if [[ -n "$summary" && ${#summary} -lt 50 ]]; then
                # Remove quotes and newlines for compactness
                local clean_summary=$(echo "$summary" | tr -d '"' | tr '\n' ' ')
                dsl_line+=",S=$clean_summary"
            fi
            
            # Add imports if present and compact
            if [[ -n "$imports" && "$imports" != '""' && ${#imports} -lt 100 ]]; then
                local clean_imports=$(echo "$imports" | tr -d '"' | tr '\n' '|')
                dsl_line+=",I=$clean_imports"
            fi
            
            output_line "$dsl_line"
            
        done < "$index_file"
    fi
    
    # Export symbol information
    if [[ -f "$symbols_file" ]]; then
        # Skip header line and process symbols
        while IFS=$'\t' read -r symbol_name kind repo file_path line_start line_end; do
            [[ $line_count -ge $max_lines ]] && break
            
            # Handle empty kind field by shifting variables
            if [[ -z "$line_end" ]]; then
                line_end="$line_start"
                line_start="$file_path"
                file_path="$repo"
                repo="$kind"
                kind=""
            fi
            
            # Clean up symbol name (remove extra whitespace)
            symbol_name=$(echo "$symbol_name" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
            
            # Skip empty symbol names
            [[ -z "$symbol_name" ]] && continue
            
            # Build symbol DSL line
            local sym_line="SYM:N=$symbol_name"
            [[ -n "$kind" ]] && sym_line+=",K=$kind"
            [[ -n "$line_start" ]] && sym_line+=",LN=$line_start"
            [[ -n "$file_path" ]] && sym_line+=",P=$file_path"
            
            output_line "$sym_line"
        done < <(tail -n +2 "$symbols_file")
    else
        # Fallback to symbols from index file
        while IFS= read -r line; do
            [[ $line_count -ge $max_lines ]] && break
            [[ -z "$line" ]] && continue
            
            local path=$(echo "$line" | jq -r '.path // ""')
            local symbols_array=$(echo "$line" | jq -c '.symbols // []')
            
            # Extract symbols - simplified to avoid nested pipes
            local symbol_data=$(echo "$symbols_array" | jq -r '.[] | "\(.name):\(.kind):\(.line_start):\(.visibility)"' 2>/dev/null)
            while IFS=':' read -r sym_name sym_kind sym_line sym_vis; do
                [[ $line_count -ge $max_lines ]] && break
                [[ -z "$sym_name" ]] && continue
                
                # Build symbol DSL line
                local sym_line_dsl="SYM:N=$sym_name"
                [[ -n "$sym_kind" && "$sym_kind" != "null" ]] && sym_line_dsl+=",K=$sym_kind"
                [[ -n "$sym_line" && "$sym_line" != "null" ]] && sym_line_dsl+=",LN=$sym_line"
                [[ -n "$sym_vis" && "$sym_vis" != "null" ]] && sym_line_dsl+=",V=$sym_vis"
                [[ -n "$path" ]] && sym_line_dsl+=",P=$path"
                
                output_line "$sym_line_dsl"
            done <<< "$symbol_data"
        done < "$index_file"
    fi
    
    # Output file location if saved to file
    if [[ "$output_format" == "file" ]]; then
        echo "DSL exported to: $output_dest"
        echo "Lines: $line_count"
        local file_size=$(wc -c < "$output_dest")
        echo "Size: $file_size bytes"
    fi
    
    return 0
}

# Command: clean
cmd_clean() {
    local out_dir=".sourceatlas"
    local dry_run=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} clean [options]

Remove generated output files while preserving source code and configuration.

Options:
  --out DIR       Output directory to clean (default: .sourceatlas)
  --dry-run       Show what would be removed without actually removing
  --help, -h      Show this help message

Examples:
  ${PROG_NAME} clean
  ${PROG_NAME} clean --out custom_output
  ${PROG_NAME} clean --dry-run
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} clean --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    # Create output directory if it doesn't exist
    mkdir -p "$out_dir"
    
    # List of files to clean (preserve config files)
    local files_to_clean=(
        "sourceatlas.index.jsonl"
        "sourceatlas.symbols.tsv"
        "sourceatlas.stats.json"
        "sourceatlas.manifest.json"
        "sourceatlas.dsl"
        "delta.report.json"
    )
    
    # Also clean shard files
    local shard_files=("${out_dir}"/sourceatlas.index.*.jsonl)
    local compressed_files=("${out_dir}"/*.gz)
    
    local cleaned_count=0
    local total_size=0
    
    if [[ "$dry_run" == true ]]; then
        echo "DRY RUN - Files that would be removed:"
        echo ""
    fi
    
    # Clean main output files
    for file in "${files_to_clean[@]}"; do
        local full_path="${out_dir}/${file}"
        if [[ -f "$full_path" ]]; then
            if [[ "$dry_run" == true ]]; then
                local size=$(wc -c < "$full_path" 2>/dev/null || echo "0")
                echo "  $full_path ($size bytes)"
                total_size=$((total_size + size))
            else
                local size=$(wc -c < "$full_path" 2>/dev/null || echo "0")
                rm -f "$full_path"
                echo "Removed: $full_path ($size bytes)"
                total_size=$((total_size + size))
            fi
            ((cleaned_count++))
        fi
    done
    
    # Clean shard files
    for shard_file in "${shard_files[@]}"; do
        if [[ -f "$shard_file" ]]; then
            if [[ "$dry_run" == true ]]; then
                local size=$(wc -c < "$shard_file" 2>/dev/null || echo "0")
                echo "  $shard_file ($size bytes)"
                total_size=$((total_size + size))
            else
                local size=$(wc -c < "$shard_file" 2>/dev/null || echo "0")
                rm -f "$shard_file"
                echo "Removed: $shard_file ($size bytes)"
                total_size=$((total_size + size))
            fi
            ((cleaned_count++))
        fi
    done
    
    # Clean compressed files
    for compressed_file in "${compressed_files[@]}"; do
        if [[ -f "$compressed_file" ]]; then
            if [[ "$dry_run" == true ]]; then
                local size=$(wc -c < "$compressed_file" 2>/dev/null || echo "0")
                echo "  $compressed_file ($size bytes)"
                total_size=$((total_size + size))
            else
                local size=$(wc -c < "$compressed_file" 2>/dev/null || echo "0")
                rm -f "$compressed_file"
                echo "Removed: $compressed_file ($size bytes)"
                total_size=$((total_size + size))
            fi
            ((cleaned_count++))
        fi
    done
    
    # Summary
    if [[ "$dry_run" == true ]]; then
        echo ""
        echo "Would remove $cleaned_count files ($total_size bytes total)"
        echo "Configuration files (.sourceatlas/config.toml, exclude_patterns.txt) would be preserved"
    else
        if [[ $cleaned_count -eq 0 ]]; then
            echo "No output files found to clean in: $out_dir"
        else
            echo ""
            echo "Cleaned $cleaned_count files ($total_size bytes total)"
            echo "Configuration files preserved"
        fi
    fi
}

# Command: verify
cmd_verify() {
    local out_dir=".sourceatlas"
    local verbose=false
    local exit_code=0
    local checks_passed=0
    local total_checks=0
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                echo "Usage: $PROG_NAME verify [options]"
                echo ""
                echo "Verify consistency between index, symbols, and manifest files"
                echo ""
                echo "Options:"
                echo "  --out DIR         Use custom output directory (default: .sourceatlas)"
                echo "  --verbose, -v     Show detailed verification information"
                echo "  --help, -h        Show this help message"
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
    
    # Required files
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    local symbols_file="${out_dir}/sourceatlas.symbols.tsv" 
    local manifest_file="${out_dir}/sourceatlas.manifest.json"
    local stats_file="${out_dir}/sourceatlas.stats.json"
    
    # Check if index exists
    if [[ ! -f "$index_file" ]]; then
        echo "Index file not found: $index_file" >&2
        exit 1
    fi
    
    if [[ "$verbose" == true ]]; then
        echo "Verifying SourceAtlas outputs in: $out_dir"
        echo ""
    fi
    
    # Check 1: Index file integrity
    ((total_checks++))
    if [[ "$verbose" == true ]]; then
        echo "Checking index file integrity..."
    fi
    
    local index_lines=$(wc -l < "$index_file" 2>/dev/null || echo "0")
    local valid_json_lines=0
    
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        if echo "$line" | jq empty 2>/dev/null; then
            ((valid_json_lines++))
        fi
    done < "$index_file"
    
    if [[ $valid_json_lines -eq $index_lines ]]; then
        if [[ "$verbose" == true ]]; then
            echo "  ✓ Index file contains $index_lines valid JSON lines"
        fi
        ((checks_passed++))
    else
        echo "  ✗ Index file contains invalid JSON ($valid_json_lines/$index_lines valid)"
        exit_code=1
    fi
    
    # Check 2: Index-Symbol consistency  
    if [[ -f "$symbols_file" ]]; then
        ((total_checks++))
        if [[ "$verbose" == true ]]; then
            echo "Checking index-symbol consistency..."
        fi
        
        local symbol_files_count=0
        local missing_files=0
        
        # Get list of files in index
        local index_files=$(mktemp)
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            echo "$line" | jq -r '.path // ""' | grep -v '^$'
        done < "$index_file" | sort -u > "$index_files"
        
        # Check each symbol reference
        while IFS=$'\t' read -r symbol line_num file_path symbol_type visibility || [[ -n "$symbol" ]]; do
            [[ -z "$symbol" || "$symbol" == "symbol" ]] && continue  # Skip header
            ((symbol_files_count++))
            if ! grep -Fxq "$file_path" "$index_files"; then
                if [[ "$verbose" == true ]]; then
                    echo "  ✗ Symbol '$symbol' references missing file: $file_path"
                fi
                ((missing_files++))
            fi
        done < "$symbols_file"
        
        rm -f "$index_files"
        
        if [[ $missing_files -eq 0 ]]; then
            if [[ "$verbose" == true ]]; then
                echo "  ✓ All $symbol_files_count symbol references are valid"
            fi
            ((checks_passed++))
        else
            echo "  ✗ $missing_files symbol references point to missing files"
            exit_code=1
        fi
    else
        if [[ "$verbose" == true ]]; then
            echo "Symbols file not found - skipping symbol consistency check"
        fi
    fi
    
    # Check 3: Manifest consistency
    if [[ -f "$manifest_file" ]]; then
        ((total_checks++))
        if [[ "$verbose" == true ]]; then
            echo "Checking manifest consistency..."
        fi
        
        # Verify manifest file count matches index
        local manifest_file_count=$(jq -r '.file_count // 0' "$manifest_file" 2>/dev/null)
        local actual_file_count=$(grep -c . "$index_file" 2>/dev/null || echo "0")
        
        if [[ "$manifest_file_count" == "$actual_file_count" ]]; then
            if [[ "$verbose" == true ]]; then
                echo "  ✓ Manifest file count matches index ($actual_file_count files)"
            fi
            ((checks_passed++))
        else
            echo "  ✗ File count mismatch - Manifest: $manifest_file_count, Index: $actual_file_count"
            exit_code=1
        fi
        
        # Verify shard information if shards exist
        local shard_files=("${out_dir}"/sourceatlas.index.*.jsonl)
        local has_shards=false
        for shard in "${shard_files[@]}"; do
            [[ -f "$shard" ]] && has_shards=true && break
        done
        
        if [[ "$has_shards" == true ]]; then
            local manifest_shards=$(jq -r '.shards[]? // empty' "$manifest_file" 2>/dev/null | wc -l)
            local actual_shards=0
            for shard in "${shard_files[@]}"; do
                [[ -f "$shard" ]] && ((actual_shards++))
            done
            
            if [[ "$manifest_shards" == "$actual_shards" ]]; then
                if [[ "$verbose" == true ]]; then
                    echo "  ✓ Manifest shard count matches actual shards ($actual_shards)"
                fi
            else
                echo "  ✗ Shard count mismatch - Manifest: $manifest_shards, Actual: $actual_shards"
                exit_code=1
            fi
        fi
    else
        if [[ "$verbose" == true ]]; then
            echo "Manifest file not found - skipping manifest consistency check"
        fi
    fi
    
    # Check 4: File existence verification (spot check)
    ((total_checks++))
    if [[ "$verbose" == true ]]; then
        echo "Verifying file existence (spot check)..."
    fi
    
    local files_checked=0
    local missing_source_files=0
    local max_files_to_check=10
    
    while IFS= read -r line && [[ $files_checked -lt $max_files_to_check ]]; do
        [[ -z "$line" ]] && continue
        local file_path=$(echo "$line" | jq -r '.path // ""')
        [[ -z "$file_path" || "$file_path" == "null" ]] && continue
        
        if [[ ! -f "$file_path" ]]; then
            if [[ "$verbose" == true ]]; then
                echo "  ✗ Indexed file no longer exists: $file_path"
            fi
            ((missing_source_files++))
        fi
        ((files_checked++))
    done < "$index_file"
    
    if [[ $missing_source_files -eq 0 ]]; then
        if [[ "$verbose" == true ]]; then
            echo "  ✓ All checked files exist ($files_checked files verified)"
        fi
        ((checks_passed++))
    else
        echo "  ✗ $missing_source_files out of $files_checked checked files are missing"
        exit_code=1
    fi
    
    # Summary
    echo ""
    if [[ $exit_code -eq 0 ]]; then
        echo "All checks passed ($checks_passed/$total_checks)"
        echo "SourceAtlas outputs are consistent"
    else
        echo "Verification failed ($checks_passed/$total_checks checks passed)"
        echo "Consistency issues detected - consider regenerating outputs"
    fi
    
    return $exit_code
}

# Command: run
cmd_run() {
    local root_dir="."
    local out_dir=".sourceatlas"
    local enable_shard=false
    local enable_compress=false
    local dry_run=false
    local verbose=false
    local languages=""
    local threads=1
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)
                root_dir="$2"
                shift 2
                ;;
            --out)
                out_dir="$2"
                shift 2
                ;;
            --shard)
                enable_shard=true
                shift
                ;;
            --compress)
                enable_compress=true
                shift
                ;;
            --langs)
                languages="$2"
                shift 2
                ;;
            --threads)
                threads="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} run [options]

Run full indexing pipeline: scan → symbols → stats → manifest

Options:
  --root DIR        Root directory to scan (default: current directory)
  --out DIR         Output directory (default: .sourceatlas)
  --shard           Enable sharding after indexing
  --compress        Compress output files
  --langs LIST      Comma-separated list of languages to process
  --threads NUM     Number of threads to use (default: 1)
  --dry-run         Show what would be done without executing
  --verbose, -v     Show detailed progress
  --help, -h        Show this help message

Examples:
  ${PROG_NAME} run
  ${PROG_NAME} run --root src --shard --compress
  ${PROG_NAME} run --langs swift,kotlin --verbose
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                echo "Run '${PROG_NAME} run --help' for usage." >&2
                exit 1
                ;;
        esac
    done
    
    if [[ "$verbose" == true ]]; then
        echo "=== SourceAtlas Pipeline ==="
        echo "Root: $root_dir"
        echo "Output: $out_dir"
        echo "Shard: $enable_shard"
        echo "Compress: $enable_compress"
        echo "Languages: ${languages:-all}"
        echo "Threads: $threads"
        echo "=========================="
    fi
    
    if [[ "$dry_run" == true ]]; then
        echo "DRY RUN MODE - No files will be created"
        echo ""
        echo "Would execute pipeline:"
        echo "1. Initialize configuration (if needed)"
        echo "2. Scan directory: $root_dir"
        echo "3. Generate symbol table"
        echo "4. Calculate statistics"
        echo "5. Create manifest"
        if [[ "$enable_shard" == true ]]; then
            echo "6. Create shards"
        fi
        if [[ "$enable_compress" == true ]]; then
            echo "7. Compress output files"
        fi
        echo ""
        echo "Output would be created in: $out_dir"
        return 0
    fi
    
    # Step 1: Initialize if needed
    if [[ ! -f ".sourceatlas/config.toml" ]] && [[ "$out_dir" == ".sourceatlas" ]]; then
        if [[ "$verbose" == true ]]; then
            echo "Step 1: Initializing configuration..."
        fi
        cmd_init
    else
        if [[ "$verbose" == true ]]; then
            echo "Step 1: Configuration already exists"
        fi
    fi
    
    # Step 2: Scan
    echo ""
    echo "=== Phase 1/4: Scanning files ==="
    if [[ "$verbose" == true ]]; then
        echo "Step 2: Scanning directory..."
    fi
    local scan_args=("--root" "$root_dir" "--out" "$out_dir")
    # Note: Language filtering will be implemented in a future phase
    # For now, scan processes all supported languages
    cmd_scan "${scan_args[@]}" || {
        echo "Error: Scan step failed" >&2
        return 1
    }
    
    # Step 3: Generate symbols
    echo ""
    echo "=== Phase 2/4: Extracting symbols ==="
    if [[ "$verbose" == true ]]; then
        echo "Step 3: Generating symbol table..."
    fi
    cmd_symbols --out "$out_dir" || {
        echo "Error: Symbols step failed" >&2
        return 1
    }
    
    # Step 4: Calculate stats
    echo ""
    echo "=== Phase 3/4: Calculating statistics ==="
    if [[ "$verbose" == true ]]; then
        echo "Step 4: Calculating statistics..."
    fi
    cmd_stats --out "$out_dir" || {
        echo "Error: Stats step failed" >&2
        return 1
    }
    
    # Step 5: Create manifest
    echo ""
    echo "=== Phase 4/4: Building manifest ==="
    if [[ "$verbose" == true ]]; then
        echo "Step 5: Creating manifest..."
    fi
    cmd_manifest --out "$out_dir" || {
        echo "Error: Manifest step failed" >&2
        return 1
    }
    
    # Step 6: Create shards (optional)
    if [[ "$enable_shard" == true ]]; then
        if [[ "$verbose" == true ]]; then
            echo "Step 6: Creating shards..."
        fi
        cmd_shard --out "$out_dir" || {
            echo "Error: Shard step failed" >&2
            return 1
        }
    fi
    
    # Step 7: Compress files (optional)
    if [[ "$enable_compress" == true ]]; then
        if [[ "$verbose" == true ]]; then
            echo "Step 7: Compressing files..."
        fi
        compress_output_files "$out_dir"
    fi
    
    echo ""
    echo "========================================="
    echo "✓ Pipeline completed successfully!"
    echo "========================================="
    echo ""
    echo "Output directory: $out_dir"
    
    # Show summary
    local index_file="${out_dir}/sourceatlas.index.jsonl"
    if [[ -f "$index_file" ]]; then
        local file_count=$(count_lines "$index_file")
        local index_size=$(get_file_size "$index_file")
        echo "Summary:"
        echo "  - Indexed files: $file_count"
        echo "  - Index size: $(( index_size / 1024 / 1024 )) MB"
        
        if [[ -f "$out_dir/sourceatlas.symbols.tsv" ]]; then
            local symbol_count=$(wc -l < "$out_dir/sourceatlas.symbols.tsv")
            echo "  - Symbols extracted: $((symbol_count - 1))"  # Minus header
        fi
    fi
    
    echo ""
    echo "Files created:"
    ls -lh "$out_dir"/sourceatlas.* 2>/dev/null | awk '{print "  - " $9 ": " $5}'
    
    if [[ "$verbose" == true ]]; then
        echo ""
        echo "=== Detailed file listing ==="
        ls -la "$out_dir"
        echo "========================"
    fi
}

# Compress output files
compress_output_files() {
    local out_dir="$1"
    
    # Compress JSONL and TSV files
    for file in "${out_dir}"/*.jsonl "${out_dir}"/*.tsv; do
        if [[ -f "$file" ]] && [[ ! -f "${file}.gz" ]]; then
            if command -v gzip >/dev/null 2>&1; then
                gzip -c "$file" > "${file}.gz"
                echo "Compressed: $(basename "$file")"
            else
                echo "Warning: gzip not available for compression"
                break
            fi
        fi
    done
}

# Command: verify (stub - real implementation is above)
# The actual cmd_verify implementation is above at line ~2492

# Main entry point
main() {
    local command="${1:-}"
    
    case "$command" in
        version|--version|-v)
            show_version
            ;;
        help|--help|-h|"")
            show_help
            ;;
        init)
            shift
            cmd_init "$@"
            ;;
        scan)
            shift
            cmd_scan "$@"
            ;;
        symbols)
            shift
            cmd_symbols "$@"
            ;;
        stats)
            shift
            cmd_stats "$@"
            ;;
        manifest)
            shift
            cmd_manifest "$@"
            ;;
        shard)
            shift
            cmd_shard "$@"
            ;;
        delta)
            shift
            cmd_delta "$@"
            ;;
        query)
            shift
            cmd_query "$@"
            ;;
        segment)
            shift
            cmd_segment "$@"
            ;;
        export-dsl)
            shift
            cmd_export_dsl "$@"
            ;;
        clean)
            shift
            cmd_clean "$@"
            ;;
        run)
            shift
            cmd_run "$@"
            ;;
        verify)
            shift
            cmd_verify "$@"
            ;;
        *)
            echo "Error: Unknown command: $command" >&2
            echo "Run '${PROG_NAME} help' for usage information." >&2
            exit 1
            ;;
    esac
}

# Run main function
main "$@"