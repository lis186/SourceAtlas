#!/usr/bin/env bash

# SourceAtlas - Lightweight code indexing tool for AI agents
# Main CLI entry point

set -e

# Version information
readonly VERSION="0.1.0"
readonly SCHEMA_VERSION="1"
readonly PROG_NAME="$(basename "$0")"

# Script directory
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${SCRIPT_DIR}/../lib"

# Event system globals
export EVENTS_FILE=".sourceatlas/events.jsonl"
export AUDIT_LOG=".sourceatlas/audit.log"
export TRACE_ID=""
export CURRENT_SPAN_ID=""
export PARENT_SPAN_ID=""

# Load core library if it exists
if [[ -f "${LIB_DIR}/core.sh" ]]; then
    source "${LIB_DIR}/core.sh"
fi

# ================================================================================
# Event System and Observability Functions
# ================================================================================

# Generate UUID (compatible across systems)
generate_uuid() {
    # Try different methods in order of preference
    if command -v uuidgen >/dev/null 2>&1; then
        uuidgen | tr '[:upper:]' '[:lower:]'
    elif [[ -e /proc/sys/kernel/random/uuid ]]; then
        cat /proc/sys/kernel/random/uuid
    else
        # Fallback: generate pseudo-UUID using date and random
        printf "%08x-%04x-%04x-%04x-%012x" \
            $((RANDOM * RANDOM)) \
            $((RANDOM % 65536)) \
            $((RANDOM % 65536)) \
            $((RANDOM % 65536)) \
            $((RANDOM * RANDOM * RANDOM))
    fi
}

# Get timestamp in milliseconds (cross-platform)
get_timestamp_ms() {
    # Test if date supports nanoseconds by checking the output format
    local test_output=$(date +%s%3N 2>/dev/null)
    if [[ "$test_output" =~ ^[0-9]+$ ]]; then
        # GNU date with nanoseconds - actually working
        echo "$test_output"
    else
        # macOS/BSD date fallback - seconds only, append 000
        echo "$(date +%s)000"
    fi
}

# Initialize event system
init_event_system() {
    local out_dir="${1:-.sourceatlas}"
    mkdir -p "$out_dir"
    
    # Initialize TRACE_ID if not set
    if [[ -z "$TRACE_ID" ]]; then
        export TRACE_ID="$(generate_uuid)"
    fi
    
    # Update global paths
    export EVENTS_FILE="$out_dir/events.jsonl"
    export AUDIT_LOG="$out_dir/audit.log"
    
    # Create events file if it doesn't exist
    if [[ ! -f "$EVENTS_FILE" ]]; then
        touch "$EVENTS_FILE"
    fi
    
    # Create audit log if it doesn't exist
    if [[ ! -f "$AUDIT_LOG" ]]; then
        touch "$AUDIT_LOG"
    fi
}

# Emit structured event (OpenTelemetry compatible)
emit_event() {
    local event_type="$1"
    local event_data="${2:-{}}"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local hostname="${HOSTNAME:-$(hostname 2>/dev/null || echo 'unknown')}"
    
    # Ensure event_data is valid JSON - if not, wrap it
    if ! echo "$event_data" | jq empty 2>/dev/null; then
        event_data="{\"raw_data\":\"$(echo "$event_data" | sed 's/"/\\"/g')\"}"
    fi
    
    # Create simplified event first for debugging
    local event=$(jq -n \
        --arg timestamp "$timestamp" \
        --arg trace_id "$TRACE_ID" \
        --arg type "$event_type" \
        --arg hostname "$hostname" \
        --arg user "${USER:-unknown}" \
        '{
            timestamp: $timestamp,
            trace_id: $trace_id,
            type: $type,
            hostname: $hostname,
            user: $user
        }')
    
    # Write to events file (create directory if needed)
    local events_dir="$(dirname "$EVENTS_FILE")"
    mkdir -p "$events_dir"
    echo "$event" >> "$EVENTS_FILE" 2>/dev/null || true
    
    # Also write human-readable entry to audit log
    printf "[%s] %s: %s (trace: %s)\n" \
        "$timestamp" \
        "$event_type" \
        "event" \
        "$TRACE_ID" \
        >> "$AUDIT_LOG" 2>/dev/null || true
}

# Start a new span (for distributed tracing)
start_span() {
    local span_name="$1"
    local parent_span="${CURRENT_SPAN_ID}"
    
    # Generate new span ID
    export PARENT_SPAN_ID="$parent_span"
    export CURRENT_SPAN_ID="$(generate_uuid | cut -c1-8)"
    
    # Emit span start event
    emit_event "span_started" "{
        \"span_name\": \"$span_name\",
        \"parent_span_id\": \"$parent_span\",
        \"start_time\": $(get_timestamp_ms)
    }"
}

# End current span
end_span() {
    local span_name="${1:-unknown}"
    local exit_code="${2:-0}"
    
    # Emit span end event
    emit_event "span_ended" "{
        \"span_name\": \"$span_name\",
        \"exit_code\": $exit_code,
        \"end_time\": $(get_timestamp_ms)
    }"
    
    # Restore parent span
    export CURRENT_SPAN_ID="$PARENT_SPAN_ID"
    export PARENT_SPAN_ID=""
}

# Track performance of a command
track_performance() {
    local operation_name="$1"
    shift
    local start_time=$(get_timestamp_ms)
    
    start_span "$operation_name"
    
    # Execute command and capture exit code
    local exit_code=0
    "$@" || exit_code=$?
    
    local end_time=$(get_timestamp_ms)
    local duration_ms=$((end_time - start_time))
    
    # Emit performance event
    emit_event "performance_measured" "{
        \"operation\": \"$operation_name\",
        \"duration_ms\": $duration_ms,
        \"exit_code\": $exit_code,
        \"command\": \"$*\"
    }"
    
    end_span "$operation_name" "$exit_code"
    return $exit_code
}

# ================================================================================
# State Machine Framework for File Processing
# ================================================================================

# State machine states
readonly STATE_INIT="INIT"
readonly STATE_VALIDATE="VALIDATE"
readonly STATE_EXTRACT_METADATA="EXTRACT_METADATA"
readonly STATE_EXTRACT_SYMBOLS="EXTRACT_SYMBOLS"
readonly STATE_GENERATE_SUMMARY="GENERATE_SUMMARY"
readonly STATE_COMPLETE="COMPLETE"
readonly STATE_FAILED="FAILED"
readonly STATE_SKIPPED="SKIPPED"

# State persistence file
export STATE_DB_FILE=".sourceatlas/state.db"

# Initialize state database
init_state_db() {
    local out_dir="${1:-.sourceatlas}"
    mkdir -p "$out_dir"
    export STATE_DB_FILE="$out_dir/state.db"
    
    # Create state db header if it doesn't exist
    if [[ ! -f "$STATE_DB_FILE" ]]; then
        echo "# SourceAtlas State Database" > "$STATE_DB_FILE"
        echo "# Format: file_path|current_state|last_updated|retry_count|error_message" >> "$STATE_DB_FILE"
    fi
}

# Get current state for a file
get_file_state() {
    local file_path="$1"
    
    if [[ ! -f "$STATE_DB_FILE" ]]; then
        echo "$STATE_INIT"
        return
    fi
    
    # Find the file in state db
    local state_line=$(grep -F "$file_path|" "$STATE_DB_FILE" 2>/dev/null | tail -1)
    if [[ -n "$state_line" ]]; then
        echo "$state_line" | cut -d'|' -f2
    else
        echo "$STATE_INIT"
    fi
}

# Update file state in database
update_file_state() {
    local file_path="$1"
    local new_state="$2"
    local error_message="${3:-}"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Get current retry count
    local current_entry=$(grep -F "$file_path|" "$STATE_DB_FILE" 2>/dev/null | tail -1)
    local retry_count=0
    if [[ -n "$current_entry" ]]; then
        retry_count=$(echo "$current_entry" | cut -d'|' -f4)
        # Increment retry count if moving to failed state
        if [[ "$new_state" == "$STATE_FAILED" ]]; then
            retry_count=$((retry_count + 1))
        fi
    fi
    
    # Escape pipe characters in error message
    error_message=$(echo "$error_message" | sed 's/|/\\|/g')
    
    # Append new state entry
    echo "$file_path|$new_state|$timestamp|$retry_count|$error_message" >> "$STATE_DB_FILE"
    
    # Emit state change event
    emit_event "state_changed" "{
        \"file\": \"$file_path\",
        \"new_state\": \"$new_state\",
        \"retry_count\": $retry_count,
        \"error\": \"$error_message\"
    }"
}

# ================================================================================
# Circuit Breaker and Self-Healing Mechanisms
# ================================================================================

# Circuit breaker states
readonly CB_CLOSED="CLOSED"     # Normal operation
readonly CB_OPEN="OPEN"         # Failures detected, stop processing
readonly CB_HALF_OPEN="HALF_OPEN" # Testing if service has recovered

# Circuit breaker configuration
readonly CB_FAILURE_THRESHOLD=5          # Failures before opening circuit
readonly CB_SUCCESS_THRESHOLD=3          # Successes needed to close circuit
readonly CB_TIMEOUT_SECONDS=60           # Time before trying half-open
readonly CB_RECOVERY_WINDOW=300          # Window for counting failures (5 minutes)

# Circuit breaker database file
export CB_DB_FILE=".sourceatlas/circuit_breaker.db"

# ================================================================================
# Data Lineage Tracking System  
# ================================================================================

# Lineage tracking file
export LINEAGE_FILE=".sourceatlas/lineage.jsonl"

# Initialize lineage tracking
init_lineage_tracking() {
    local out_dir="${1:-.sourceatlas}"
    mkdir -p "$out_dir"
    export LINEAGE_FILE="$out_dir/lineage.jsonl"
    
    # Create lineage file if it doesn't exist
    if [[ ! -f "$LINEAGE_FILE" ]]; then
        touch "$LINEAGE_FILE"
    fi
}

# Record lineage event
record_lineage_event() {
    local event_type="$1"
    local source_entity="$2"
    local target_entity="$3"
    local operation="$4"
    local metadata="${5:-{}}"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local event_id=$(generate_uuid)
    
    # Build lineage record
    local lineage_record=$(cat <<EOF
{
  "event_id": "$event_id",
  "timestamp": "$timestamp",
  "event_type": "$event_type",
  "operation": "$operation",
  "source": {
    "entity": "$source_entity",
    "type": "$(determine_entity_type "$source_entity")"
  },
  "target": {
    "entity": "$target_entity", 
    "type": "$(determine_entity_type "$target_entity")"
  },
  "trace_id": "$TRACE_ID",
  "span_id": "$CURRENT_SPAN_ID",
  "metadata": $metadata
}
EOF
)
    
    # Write to lineage file
    echo "$lineage_record" >> "$LINEAGE_FILE"
    
    # Also emit as regular event
    emit_event "lineage_recorded" "{
        \"event_id\": \"$event_id\",
        \"event_type\": \"$event_type\",
        \"source\": \"$source_entity\",
        \"target\": \"$target_entity\",
        \"operation\": \"$operation\"
    }"
}

# Determine entity type from path/name
determine_entity_type() {
    local entity="$1"
    
    if [[ -z "$entity" ]]; then
        echo "unknown"
        return
    fi
    
    # Check if it's a file path
    if [[ "$entity" =~ ^.*\.[a-zA-Z0-9]+$ ]]; then
        if [[ "$entity" =~ \.jsonl$ ]]; then
            echo "index_file"
        elif [[ "$entity" =~ \.tsv$ ]]; then
            echo "symbol_table"
        elif [[ "$entity" =~ \.json$ ]]; then
            echo "metadata_file"
        elif [[ "$entity" =~ \.(swift|kt|m|h)$ ]]; then
            echo "source_file"
        else
            echo "file"
        fi
    elif [[ "$entity" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        echo "symbol"
    elif [[ "$entity" =~ ^.*\/.*$ ]]; then
        echo "path"
    else
        echo "entity"
    fi
}

# Record data transformation lineage
record_data_transformation() {
    local input_file="$1"
    local output_file="$2"
    local transformation_type="$3"
    local details="${4:-{}}"
    
    record_lineage_event "data_transformation" "$input_file" "$output_file" "$transformation_type" "$details"
}

# Record symbol extraction lineage
record_symbol_extraction() {
    local source_file="$1"
    local symbol_name="$2"
    local symbol_type="$3"
    local line_number="$4"
    
    local metadata=$(cat <<EOF
{
  "symbol_type": "$symbol_type",
  "line_number": $line_number,
  "extraction_method": "ctags_with_regex_fallback"
}
EOF
)
    
    record_lineage_event "symbol_extraction" "$source_file" "$symbol_name" "extract_symbol" "$metadata"
}

# Record aggregation lineage (multiple inputs -> one output)
record_aggregation() {
    local operation="$1"
    local output_entity="$2"
    shift 2
    local input_entities=("$@")
    
    local inputs_json="["
    local first=true
    for input in "${input_entities[@]}"; do
        if [[ "$first" != "true" ]]; then
            inputs_json+=","
        fi
        first=false
        inputs_json+="\"$input\""
    done
    inputs_json+="]"
    
    local metadata=$(cat <<EOF
{
  "input_count": ${#input_entities[@]},
  "inputs": $inputs_json
}
EOF
)
    
    # Record one event per input
    for input in "${input_entities[@]}"; do
        record_lineage_event "aggregation" "$input" "$output_entity" "$operation" "$metadata"
    done
}

# Record file processing lineage
record_file_processing_lineage() {
    local file_path="$1"
    local processing_stage="$2"
    local input_data="$3"
    local output_data="$4"
    local success="$5"
    
    local metadata=$(cat <<EOF
{
  "processing_stage": "$processing_stage",
  "success": $success,
  "input_size": ${#input_data},
  "output_size": ${#output_data},
  "file_size": $(stat -f%z "$file_path" 2>/dev/null || stat -c%s "$file_path" 2>/dev/null || echo 0)
}
EOF
)
    
    local event_type="file_processing"
    if [[ "$success" == "true" ]]; then
        event_type="successful_processing"
    else
        event_type="failed_processing"
    fi
    
    record_lineage_event "$event_type" "$file_path" "${file_path}_${processing_stage}" "$processing_stage" "$metadata"
}

# Query lineage by entity
query_lineage_by_entity() {
    local entity="$1"
    local direction="${2:-both}" # upstream, downstream, both
    
    if [[ ! -f "$LINEAGE_FILE" ]]; then
        echo "[]"
        return
    fi
    
    case "$direction" in
        "upstream")
            grep "\"target\".*\"entity\":.*\"$entity\"" "$LINEAGE_FILE" 2>/dev/null || echo ""
            ;;
        "downstream")
            grep "\"source\".*\"entity\":.*\"$entity\"" "$LINEAGE_FILE" 2>/dev/null || echo ""
            ;;
        "both")
            (grep "\"target\".*\"entity\":.*\"$entity\"" "$LINEAGE_FILE" 2>/dev/null || echo "")
            (grep "\"source\".*\"entity\":.*\"$entity\"" "$LINEAGE_FILE" 2>/dev/null || echo "")
            ;;
    esac
}

# Get lineage statistics
get_lineage_stats() {
    local out_dir="${1:-.sourceatlas}"
    local lineage_file="$out_dir/lineage.jsonl"
    
    if [[ ! -f "$lineage_file" ]]; then
        echo "{\"total_events\": 0, \"entities\": 0, \"operations\": 0}"
        return
    fi
    
    local total_events=$(wc -l < "$lineage_file" | tr -d ' ')
    local unique_entities=$(grep -o '"entity": "[^"]*"' "$lineage_file" | sort -u | wc -l | tr -d ' ')
    local unique_operations=$(grep -o '"operation": "[^"]*"' "$lineage_file" | sort -u | wc -l | tr -d ' ')
    
    echo "{\"total_events\": $total_events, \"entities\": $unique_entities, \"operations\": $unique_operations}"
}

# Trace full lineage path
trace_lineage_path() {
    local start_entity="$1"
    local end_entity="$2" 
    local max_depth="${3:-10}"
    
    if [[ ! -f "$LINEAGE_FILE" ]]; then
        echo "[]"
        return
    fi
    
    # Simple implementation - trace downstream from start to end
    # This is a basic version; a full implementation would use graph traversal
    local path="[]"
    local current_entity="$start_entity"
    local depth=0
    
    while [[ $depth -lt $max_depth && "$current_entity" != "$end_entity" ]]; do
        local next_entity=$(grep "\"source\".*\"entity\":.*\"$current_entity\"" "$LINEAGE_FILE" | head -1 | grep -o '"target".*"entity": "[^"]*"' | cut -d'"' -f4)
        
        if [[ -z "$next_entity" ]]; then
            break
        fi
        
        current_entity="$next_entity"
        ((depth++))
    done
    
    if [[ "$current_entity" == "$end_entity" ]]; then
        echo "{\"path_found\": true, \"depth\": $depth}"
    else
        echo "{\"path_found\": false, \"depth\": $depth}"
    fi
}

# Initialize circuit breaker database
init_circuit_breaker_db() {
    local out_dir="${1:-.sourceatlas}"
    mkdir -p "$out_dir"
    export CB_DB_FILE="$out_dir/circuit_breaker.db"
    
    # Create circuit breaker db header if it doesn't exist
    if [[ ! -f "$CB_DB_FILE" ]]; then
        echo "# SourceAtlas Circuit Breaker Database" > "$CB_DB_FILE"
        echo "# Format: operation|state|failure_count|success_count|last_failure|last_success|opened_at" >> "$CB_DB_FILE"
        # Initialize default operations
        local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        echo "file_processing|$CB_CLOSED|0|0|$timestamp|$timestamp|" >> "$CB_DB_FILE"
        echo "symbol_extraction|$CB_CLOSED|0|0|$timestamp|$timestamp|" >> "$CB_DB_FILE"
        echo "metadata_extraction|$CB_CLOSED|0|0|$timestamp|$timestamp|" >> "$CB_DB_FILE"
    fi
}

# Get circuit breaker state for an operation
get_circuit_breaker_state() {
    local operation="$1"
    
    if [[ ! -f "$CB_DB_FILE" ]]; then
        echo "$CB_CLOSED"
        return
    fi
    
    # Find the operation in circuit breaker db
    local cb_line=$(grep "^$operation|" "$CB_DB_FILE" 2>/dev/null | tail -1)
    if [[ -n "$cb_line" ]]; then
        echo "$cb_line" | cut -d'|' -f2
    else
        echo "$CB_CLOSED"
    fi
}

# Update circuit breaker state
update_circuit_breaker_state() {
    local operation="$1"
    local new_state="$2"
    local failure_count="$3"
    local success_count="$4"
    local last_failure="$5"
    local last_success="$6"
    local opened_at="$7"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Remove old entry and add new one
    if [[ -f "$CB_DB_FILE" ]]; then
        grep -v "^$operation|" "$CB_DB_FILE" > "${CB_DB_FILE}.tmp" 2>/dev/null || touch "${CB_DB_FILE}.tmp"
        mv "${CB_DB_FILE}.tmp" "$CB_DB_FILE"
    fi
    
    echo "$operation|$new_state|$failure_count|$success_count|$last_failure|$last_success|$opened_at" >> "$CB_DB_FILE"
    
    emit_event "circuit_breaker_state_changed" "{
        \"operation\": \"$operation\",
        \"new_state\": \"$new_state\",
        \"failure_count\": $failure_count,
        \"success_count\": $success_count,
        \"timestamp\": \"$timestamp\"
    }"
}

# Record circuit breaker success
record_circuit_breaker_success() {
    local operation="$1"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    if [[ ! -f "$CB_DB_FILE" ]]; then
        init_circuit_breaker_db
    fi
    
    # Get current circuit breaker data
    local cb_line=$(grep "^$operation|" "$CB_DB_FILE" 2>/dev/null | tail -1)
    if [[ -z "$cb_line" ]]; then
        # Initialize new operation
        update_circuit_breaker_state "$operation" "$CB_CLOSED" 0 1 "$timestamp" "$timestamp" ""
        return
    fi
    
    local current_state=$(echo "$cb_line" | cut -d'|' -f2)
    local failure_count=$(echo "$cb_line" | cut -d'|' -f3)
    local success_count=$(echo "$cb_line" | cut -d'|' -f4)
    local last_failure=$(echo "$cb_line" | cut -d'|' -f5)
    local opened_at=$(echo "$cb_line" | cut -d'|' -f7)
    
    success_count=$((success_count + 1))
    
    # State transitions based on success
    case "$current_state" in
        "$CB_OPEN")
            # Don't change state on success while open (should not happen)
            ;;
        "$CB_HALF_OPEN")
            if [[ $success_count -ge $CB_SUCCESS_THRESHOLD ]]; then
                # Close the circuit - service has recovered
                update_circuit_breaker_state "$operation" "$CB_CLOSED" 0 0 "$last_failure" "$timestamp" ""
                emit_event "circuit_breaker_closed" "{
                    \"operation\": \"$operation\",
                    \"success_count\": $success_count,
                    \"message\": \"Circuit breaker closed - service recovered\"
                }"
            else
                # Still testing recovery
                update_circuit_breaker_state "$operation" "$CB_HALF_OPEN" "$failure_count" "$success_count" "$last_failure" "$timestamp" "$opened_at"
            fi
            ;;
        "$CB_CLOSED")
            # Reset failure count on success
            update_circuit_breaker_state "$operation" "$CB_CLOSED" 0 "$success_count" "$last_failure" "$timestamp" ""
            ;;
    esac
}

# Record circuit breaker failure
record_circuit_breaker_failure() {
    local operation="$1"
    local error_message="$2"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    if [[ ! -f "$CB_DB_FILE" ]]; then
        init_circuit_breaker_db
    fi
    
    # Get current circuit breaker data
    local cb_line=$(grep "^$operation|" "$CB_DB_FILE" 2>/dev/null | tail -1)
    if [[ -z "$cb_line" ]]; then
        # Initialize new operation with failure
        update_circuit_breaker_state "$operation" "$CB_CLOSED" 1 0 "$timestamp" "$timestamp" ""
        return
    fi
    
    local current_state=$(echo "$cb_line" | cut -d'|' -f2)
    local failure_count=$(echo "$cb_line" | cut -d'|' -f3)
    local success_count=$(echo "$cb_line" | cut -d'|' -f4)
    local last_success=$(echo "$cb_line" | cut -d'|' -f6)
    local opened_at=$(echo "$cb_line" | cut -d'|' -f7)
    
    failure_count=$((failure_count + 1))
    
    # State transitions based on failure
    case "$current_state" in
        "$CB_CLOSED")
            if [[ $failure_count -ge $CB_FAILURE_THRESHOLD ]]; then
                # Open the circuit - too many failures
                update_circuit_breaker_state "$operation" "$CB_OPEN" "$failure_count" 0 "$timestamp" "$last_success" "$timestamp"
                emit_event "circuit_breaker_opened" "{
                    \"operation\": \"$operation\",
                    \"failure_count\": $failure_count,
                    \"threshold\": $CB_FAILURE_THRESHOLD,
                    \"message\": \"Circuit breaker opened - too many failures\",
                    \"error\": \"$error_message\"
                }"
            else
                # Still closed, just increment failure count
                update_circuit_breaker_state "$operation" "$CB_CLOSED" "$failure_count" "$success_count" "$timestamp" "$last_success" ""
            fi
            ;;
        "$CB_HALF_OPEN")
            # Failure during testing - reopen circuit
            update_circuit_breaker_state "$operation" "$CB_OPEN" "$failure_count" 0 "$timestamp" "$last_success" "$timestamp"
            emit_event "circuit_breaker_reopened" "{
                \"operation\": \"$operation\",
                \"message\": \"Circuit breaker reopened - failure during recovery test\",
                \"error\": \"$error_message\"
            }"
            ;;
        "$CB_OPEN")
            # Already open, just update failure info
            update_circuit_breaker_state "$operation" "$CB_OPEN" "$failure_count" "$success_count" "$timestamp" "$last_success" "$opened_at"
            ;;
    esac
}

# Check if circuit breaker allows operation
circuit_breaker_allows_operation() {
    local operation="$1"
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local current_ts=$(date +%s)
    
    if [[ ! -f "$CB_DB_FILE" ]]; then
        init_circuit_breaker_db
        echo "true"
        return
    fi
    
    local cb_line=$(grep "^$operation|" "$CB_DB_FILE" 2>/dev/null | tail -1)
    if [[ -z "$cb_line" ]]; then
        echo "true"
        return
    fi
    
    local current_state=$(echo "$cb_line" | cut -d'|' -f2)
    local opened_at=$(echo "$cb_line" | cut -d'|' -f7)
    
    case "$current_state" in
        "$CB_CLOSED")
            echo "true"
            return
            ;;
        "$CB_HALF_OPEN")
            echo "true"
            return
            ;;
        "$CB_OPEN")
            if [[ -n "$opened_at" ]]; then
                # Check if timeout period has passed
                local opened_ts=$(date -d "$opened_at" +%s 2>/dev/null || echo $current_ts)
                local elapsed=$((current_ts - opened_ts))
                
                if [[ $elapsed -ge $CB_TIMEOUT_SECONDS ]]; then
                    # Move to half-open state
                    local failure_count=$(echo "$cb_line" | cut -d'|' -f3)
                    local last_failure=$(echo "$cb_line" | cut -d'|' -f5)
                    local last_success=$(echo "$cb_line" | cut -d'|' -f6)
                    
                    update_circuit_breaker_state "$operation" "$CB_HALF_OPEN" "$failure_count" 0 "$last_failure" "$last_success" "$opened_at"
                    emit_event "circuit_breaker_half_opened" "{
                        \"operation\": \"$operation\",
                        \"message\": \"Circuit breaker moved to half-open - testing recovery\"
                    }"
                    echo "true"
                    return
                fi
            fi
            echo "false"
            return
            ;;
    esac
}

# Execute operation with circuit breaker protection
execute_with_circuit_breaker() {
    local operation="$1"
    local command="$2"
    shift 2
    local args=("$@")
    
    # Check if circuit breaker allows operation
    local allowed=$(circuit_breaker_allows_operation "$operation")
    if [[ "$allowed" != "true" ]]; then
        emit_event "circuit_breaker_blocked_operation" "{
            \"operation\": \"$operation\",
            \"message\": \"Operation blocked by circuit breaker\"
        }"
        return 1
    fi
    
    # Execute the operation
    local start_time=$(get_timestamp_ms)
    local exit_code=0
    
    if "$command" "${args[@]}"; then
        # Success
        record_circuit_breaker_success "$operation"
        local end_time=$(get_timestamp_ms)
        emit_event "circuit_breaker_operation_success" "{
            \"operation\": \"$operation\",
            \"duration_ms\": $((end_time - start_time))
        }"
        return 0
    else
        # Failure
        exit_code=$?
        record_circuit_breaker_failure "$operation" "Operation failed with exit code $exit_code"
        local end_time=$(get_timestamp_ms)
        emit_event "circuit_breaker_operation_failure" "{
            \"operation\": \"$operation\",
            \"exit_code\": $exit_code,
            \"duration_ms\": $((end_time - start_time))
        }"
        return $exit_code
    fi
}

# Get circuit breaker status for all operations
get_circuit_breaker_status() {
    local out_dir="${1:-.sourceatlas}"
    local cb_db="$out_dir/circuit_breaker.db"
    
    if [[ ! -f "$cb_db" ]]; then
        echo "[]"
        return
    fi
    
    echo "["
    local first=true
    while IFS='|' read -r operation state failure_count success_count last_failure last_success opened_at; do
        # Skip comments and empty lines
        [[ "$operation" =~ ^#.*$ ]] || [[ -z "$operation" ]] && continue
        
        if [[ "$first" != "true" ]]; then
            echo ","
        fi
        first=false
        
        echo "  {"
        echo "    \"operation\": \"$operation\","
        echo "    \"state\": \"$state\","
        echo "    \"failure_count\": $failure_count,"
        echo "    \"success_count\": $success_count,"
        echo "    \"last_failure\": \"$last_failure\","
        echo "    \"last_success\": \"$last_success\","
        echo "    \"opened_at\": \"$opened_at\""
        echo -n "  }"
    done < "$cb_db"
    echo ""
    echo "]"
}

# State machine processor for a single file
process_file_state_machine() {
    local file_path="$1"
    local max_retries="${2:-3}"
    
    # Check if file processing is allowed by circuit breaker
    local allowed=$(circuit_breaker_allows_operation "file_processing")
    if [[ "$allowed" != "true" ]]; then
        emit_event "file_processing_blocked" "{
            \"file\": \"$file_path\",
            \"message\": \"File processing blocked by circuit breaker\"
        }"
        update_file_state "$file_path" "$STATE_SKIPPED" "Processing blocked by circuit breaker"
        return 1
    fi
    
    start_span "file_processing_$(basename "$file_path")"
    
    local current_state=$(get_file_state "$file_path")
    local retry_count=0
    
    emit_event "file_processing_started" "{
        \"file\": \"$file_path\",
        \"initial_state\": \"$current_state\"
    }"
    
    # State machine loop
    while [[ "$current_state" != "$STATE_COMPLETE" && "$current_state" != "$STATE_FAILED" && "$current_state" != "$STATE_SKIPPED" ]]; do
        
        emit_event "state_processing" "{
            \"file\": \"$file_path\",
            \"state\": \"$current_state\",
            \"retry_count\": $retry_count
        }"
        
        case "$current_state" in
            "$STATE_INIT")
                if sm_init_file "$file_path"; then
                    current_state="$STATE_VALIDATE"
                    update_file_state "$file_path" "$current_state"
                else
                    update_file_state "$file_path" "$STATE_FAILED" "Failed to initialize file processing"
                    current_state="$STATE_FAILED"
                fi
                ;;
                
            "$STATE_VALIDATE")
                if sm_validate_file "$file_path"; then
                    current_state="$STATE_EXTRACT_METADATA"
                    update_file_state "$file_path" "$current_state"
                else
                    if (( retry_count < max_retries )); then
                        update_file_state "$file_path" "$STATE_VALIDATE" "Validation failed, retrying"
                        ((retry_count++))
                    else
                        update_file_state "$file_path" "$STATE_SKIPPED" "Validation failed after $max_retries retries"
                        current_state="$STATE_SKIPPED"
                    fi
                fi
                ;;
                
            "$STATE_EXTRACT_METADATA")
                if execute_with_circuit_breaker "metadata_extraction" sm_extract_metadata "$file_path"; then
                    current_state="$STATE_EXTRACT_SYMBOLS"
                    update_file_state "$file_path" "$current_state"
                else
                    if (( retry_count < max_retries )); then
                        update_file_state "$file_path" "$STATE_EXTRACT_METADATA" "Metadata extraction failed, retrying"
                        ((retry_count++))
                    else
                        update_file_state "$file_path" "$STATE_FAILED" "Metadata extraction failed after $max_retries retries"
                        current_state="$STATE_FAILED"
                    fi
                fi
                ;;
                
            "$STATE_EXTRACT_SYMBOLS")
                if execute_with_circuit_breaker "symbol_extraction" sm_extract_symbols "$file_path"; then
                    current_state="$STATE_GENERATE_SUMMARY"
                    update_file_state "$file_path" "$current_state"
                else
                    if (( retry_count < max_retries )); then
                        update_file_state "$file_path" "$STATE_EXTRACT_SYMBOLS" "Symbol extraction failed, retrying"
                        ((retry_count++))
                    else
                        update_file_state "$file_path" "$STATE_FAILED" "Symbol extraction failed after $max_retries retries"
                        current_state="$STATE_FAILED"
                    fi
                fi
                ;;
                
            "$STATE_GENERATE_SUMMARY")
                if sm_generate_summary "$file_path"; then
                    current_state="$STATE_COMPLETE"
                    update_file_state "$file_path" "$current_state"
                else
                    if (( retry_count < max_retries )); then
                        update_file_state "$file_path" "$STATE_GENERATE_SUMMARY" "Summary generation failed, retrying"
                        ((retry_count++))
                    else
                        update_file_state "$file_path" "$STATE_FAILED" "Summary generation failed after $max_retries retries"
                        current_state="$STATE_FAILED"
                    fi
                fi
                ;;
                
            *)
                update_file_state "$file_path" "$STATE_FAILED" "Unknown state: $current_state"
                current_state="$STATE_FAILED"
                ;;
        esac
        
        # Prevent infinite loops
        if (( retry_count > max_retries * 2 )); then
            update_file_state "$file_path" "$STATE_FAILED" "Too many retries, aborting"
            current_state="$STATE_FAILED"
        fi
    done
    
    emit_event "file_processing_completed" "{
        \"file\": \"$file_path\",
        \"final_state\": \"$current_state\",
        \"total_retries\": $retry_count
    }"
    
    # Record circuit breaker result
    if [[ "$current_state" == "$STATE_COMPLETE" ]]; then
        record_circuit_breaker_success "file_processing"
        end_span "file_processing_$(basename "$file_path")" 0
        return 0
    else
        record_circuit_breaker_failure "file_processing" "File processing failed with state: $current_state"
        end_span "file_processing_$(basename "$file_path")" 1
        return 1
    fi
}

# State machine step implementations
sm_init_file() {
    local file_path="$1"
    
    # Check if file exists and is readable
    [[ -f "$file_path" && -r "$file_path" ]]
}

sm_validate_file() {
    local file_path="$1"
    
    # Basic validation: file should exist, be readable, and not empty
    if [[ ! -f "$file_path" ]]; then
        return 1
    fi
    
    if [[ ! -r "$file_path" ]]; then
        return 1
    fi
    
    # Check if file is not empty (allow empty files for now)
    # Could add more validation rules here
    return 0
}

sm_extract_metadata() {
    local file_path="$1"
    
    # Record lineage for metadata extraction start
    record_file_processing_lineage "$file_path" "metadata_extraction" "$file_path" "" "true"
    
    # Extract basic metadata: size, lines, hash
    local size_bytes=$(get_file_size "$file_path" 2>/dev/null)
    local loc=$(count_lines "$file_path" 2>/dev/null)
    local content_hash=$(calculate_hash "$file_path" 2>/dev/null)
    
    if [[ -n "$size_bytes" && -n "$loc" && -n "$content_hash" ]]; then
        # Record detailed lineage for extracted metadata
        local metadata_output="size:$size_bytes,loc:$loc,hash:$content_hash"
        record_file_processing_lineage "$file_path" "metadata_extraction" "$file_path" "$metadata_output" "true"
        
        # Record data transformation
        record_data_transformation "$file_path" "${file_path}_metadata" "metadata_extraction" "{
            \"size_bytes\": $size_bytes,
            \"lines_of_code\": $loc,
            \"content_hash\": \"$content_hash\"
        }"
        return 0
    else
        # Record failed extraction
        record_file_processing_lineage "$file_path" "metadata_extraction" "$file_path" "" "false"
        return 1
    fi
}

sm_extract_symbols() {
    local file_path="$1"
    
    # Record lineage for symbol extraction start
    record_file_processing_lineage "$file_path" "symbol_extraction" "$file_path" "" "true"
    
    # Get language for file
    local ext=$(get_extension "$file_path")
    local lang=$(get_language "$ext")
    
    # Extract symbols based on language
    local symbols_json=$(extract_symbols "$file_path" "$lang" 2>/dev/null)
    
    # Record individual symbol lineage if symbols were found
    if [[ -n "$symbols_json" && "$symbols_json" != "[]" ]]; then
        # Parse symbols and record lineage for each
        echo "$symbols_json" | sed -n 's/.*"name": *"\([^"]*\)".*/\1/p' | while read -r symbol_name; do
            if [[ -n "$symbol_name" ]]; then
                local symbol_type=$(echo "$symbols_json" | grep -A5 "\"name\": *\"$symbol_name\"" | grep -o '"kind": *"[^"]*"' | cut -d'"' -f4)
                local line_number=$(echo "$symbols_json" | grep -A5 "\"name\": *\"$symbol_name\"" | grep -o '"line_start": *[0-9]*' | cut -d':' -f2 | tr -d ' ')
                record_symbol_extraction "$file_path" "$symbol_name" "$symbol_type" "$line_number"
            fi
        done
        
        # Record successful symbol extraction transformation
        record_data_transformation "$file_path" "${file_path}_symbols" "symbol_extraction" "{
            \"language\": \"$lang\",
            \"symbols_count\": $(echo "$symbols_json" | grep -o '"name":' | wc -l | tr -d ' ')
        }"
    fi
    
    # Record final lineage
    record_file_processing_lineage "$file_path" "symbol_extraction" "$file_path" "$symbols_json" "true"
    
    # Symbol extraction is considered successful even if no symbols found
    # (some files legitimately have no symbols)
    return 0
}

sm_generate_summary() {
    local file_path="$1"
    
    # Generate summary for the file
    local ext=$(get_extension "$file_path")
    local lang=$(get_language "$ext")
    local role=$(detect_role "$file_path")
    
    local summary=$(generate_summary "$file_path" "$lang" "$role" 2>/dev/null)
    
    # Summary generation is considered successful even if empty
    return 0
}

# Recover processing from a specific state
recover_file_processing() {
    local file_path="$1"
    local from_state="${2:-}"
    
    if [[ -n "$from_state" ]]; then
        update_file_state "$file_path" "$from_state"
    fi
    
    process_file_state_machine "$file_path"
}

# Get processing statistics
get_processing_stats() {
    local out_dir="${1:-.sourceatlas}"
    local state_db="$out_dir/state.db"
    
    if [[ ! -f "$state_db" ]]; then
        echo "{\"total\": 0, \"complete\": 0, \"failed\": 0, \"skipped\": 0}"
        return
    fi
    
    local total=$(grep -v "^#" "$state_db" | wc -l | tr -d ' ')
    local complete=$(grep -F "|$STATE_COMPLETE|" "$state_db" | wc -l | tr -d ' ')
    local failed=$(grep -F "|$STATE_FAILED|" "$state_db" | wc -l | tr -d ' ')
    local skipped=$(grep -F "|$STATE_SKIPPED|" "$state_db" | wc -l | tr -d ' ')
    
    echo "{\"total\": $total, \"complete\": $complete, \"failed\": $failed, \"skipped\": $skipped}"
}

