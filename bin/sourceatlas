# ================================================================================
# Snapshot and Time Travel Debugging Functions
# ================================================================================

# Command: snapshot
cmd_snapshot() {
    local subcommand="${1:-}"
    
    case "$subcommand" in
        create)
            shift
            snapshot_create "$@"
            ;;
        restore)
            shift  
            snapshot_restore "$@"
            ;;
        list)
            shift
            snapshot_list "$@"
            ;;
        --help|-h|"")
            cat <<EOF
Usage: ${PROG_NAME} snapshot <subcommand> [options]

Snapshot and time travel debugging for processing state management.

Subcommands:
  create [name]     Create a processing state snapshot
  restore <name>    Restore from a saved snapshot
  list             List available snapshots

Examples:
  ${PROG_NAME} snapshot create before-scan
  ${PROG_NAME} snapshot restore before-scan
  ${PROG_NAME} snapshot list
EOF
            exit 0
            ;;
        *)
            echo "Error: Unknown snapshot subcommand: $subcommand" >&2
            echo "Run '${PROG_NAME} snapshot --help' for usage." >&2
            exit 1
            ;;
    esac
}

# Create a processing state snapshot
snapshot_create() {
    local snapshot_name=""
    local out_dir=".sourceatlas"
    local timestamp=$(date -u +"%Y%m%d_%H%M%S")
    local verbose=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} snapshot create [name] [options]

Create a complete processing state snapshot for time travel debugging.

Arguments:
  name             Snapshot name (default: auto-generated timestamp)

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --verbose, -v    Show detailed progress
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} snapshot create
  ${PROG_NAME} snapshot create before-scan
  ${PROG_NAME} snapshot create milestone-1 --verbose
EOF
                exit 0
                ;;
            --*)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
            *)
                if [[ -z "$snapshot_name" ]]; then
                    snapshot_name="$1"
                else
                    echo "Error: Unexpected argument: $1" >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done
    
    # Generate snapshot name if not provided
    if [[ -z "$snapshot_name" ]]; then
        snapshot_name="snapshot_${timestamp}"
    fi
    
    # Create snapshots directory
    local snapshots_dir="${out_dir}/snapshots"
    mkdir -p "$snapshots_dir"
    
    local snapshot_dir="${snapshots_dir}/${snapshot_name}"
    
    if [[ -d "$snapshot_dir" ]]; then
        echo "Error: Snapshot '$snapshot_name' already exists" >&2
        exit 1
    fi
    
    mkdir -p "$snapshot_dir"
    
    emit_event "snapshot_create_started" "{
        \"snapshot_name\": \"$snapshot_name\",
        \"snapshot_dir\": \"$snapshot_dir\",
        \"timestamp\": \"$timestamp\"
    }"
    
    if [[ "$verbose" == true ]]; then
        echo "Creating snapshot: $snapshot_name"
        echo "Snapshot directory: $snapshot_dir"
    fi
    
    local captured_files=0
    
    # Capture current state database
    if [[ -f "${out_dir}/state.db" ]]; then
        cp "${out_dir}/state.db" "${snapshot_dir}/state.db"
        captured_files=$((captured_files + 1))
        [[ "$verbose" == true ]] && echo "  ✓ Captured state database"
    fi
    
    # Capture event stream
    if [[ -f "${out_dir}/events.jsonl" ]]; then
        cp "${out_dir}/events.jsonl" "${snapshot_dir}/events.jsonl"
        captured_files=$((captured_files + 1))
        [[ "$verbose" == true ]] && echo "  ✓ Captured event stream"
    fi
    
    # Capture audit log
    if [[ -f "${out_dir}/audit.log" ]]; then
        cp "${out_dir}/audit.log" "${snapshot_dir}/audit.log"
        captured_files=$((captured_files + 1))
        [[ "$verbose" == true ]] && echo "  ✓ Captured audit log"
    fi
    
    # Capture index files
    for file in "${out_dir}"/*.jsonl "${out_dir}"/*.tsv "${out_dir}"/*.json; do
        if [[ -f "$file" ]] && [[ "$(basename "$file")" != "events.jsonl" ]]; then
            cp "$file" "${snapshot_dir}/"
            captured_files=$((captured_files + 1))
            [[ "$verbose" == true ]] && echo "  ✓ Captured $(basename "$file")"
        fi
    done
    
    # Capture configuration files
    for config_file in "${out_dir}/config.json" "${out_dir}/exclude_patterns.txt"; do
        if [[ -f "$config_file" ]]; then
            cp "$config_file" "${snapshot_dir}/"
            captured_files=$((captured_files + 1))
            [[ "$verbose" == true ]] && echo "  ✓ Captured $(basename "$config_file")"
        fi
    done
    
    # Create snapshot metadata
    cat > "${snapshot_dir}/metadata.json" <<EOF
{
  "name": "$snapshot_name",
  "created_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "timestamp": "$timestamp",
  "captured_files": $captured_files,
  "working_directory": "$(pwd)",
  "version": "$VERSION",
  "schema_version": "$SCHEMA_VERSION"
}
EOF
    
    emit_event "snapshot_create_completed" "{
        \"snapshot_name\": \"$snapshot_name\",
        \"snapshot_dir\": \"$snapshot_dir\",
        \"captured_files\": $captured_files
    }"
    
    echo "Snapshot created: $snapshot_name"
    echo "Files captured: $captured_files"
    echo "Snapshot path: $snapshot_dir"
}

# Restore from a processing state snapshot
snapshot_restore() {
    local snapshot_name=""
    local out_dir=".sourceatlas"
    local verbose=false
    local dry_run=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} snapshot restore <name> [options]

Restore processing state from a saved snapshot for time travel debugging.

Arguments:
  name             Snapshot name to restore

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --dry-run        Show what would be restored without executing
  --verbose, -v    Show detailed progress
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} snapshot restore before-scan
  ${PROG_NAME} snapshot restore milestone-1 --dry-run
  ${PROG_NAME} snapshot restore snapshot_20241201_143025 --verbose
EOF
                exit 0
                ;;
            --*)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
            *)
                if [[ -z "$snapshot_name" ]]; then
                    snapshot_name="$1"
                else
                    echo "Error: Unexpected argument: $1" >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done
    
    if [[ -z "$snapshot_name" ]]; then
        echo "Error: Snapshot name required" >&2
        echo "Run '${PROG_NAME} snapshot restore --help' for usage." >&2
        exit 1
    fi
    
    local snapshots_dir="${out_dir}/snapshots"
    local snapshot_dir="${snapshots_dir}/${snapshot_name}"
    
    if [[ ! -d "$snapshot_dir" ]]; then
        echo "Error: Snapshot '$snapshot_name' not found" >&2
        echo "Available snapshots:" >&2
        snapshot_list --out "$out_dir" | tail -n +2 >&2
        exit 1
    fi
    
    if [[ ! -f "${snapshot_dir}/metadata.json" ]]; then
        echo "Error: Snapshot '$snapshot_name' is corrupted (missing metadata)" >&2
        exit 1
    fi
    
    # Read snapshot metadata
    local metadata_json=$(cat "${snapshot_dir}/metadata.json")
    local captured_files=$(echo "$metadata_json" | grep -o '"captured_files": [0-9]*' | cut -d':' -f2 | tr -d ' ')
    local created_at=$(echo "$metadata_json" | grep -o '"created_at": "[^"]*"' | cut -d'"' -f4)
    
    emit_event "snapshot_restore_started" "{
        \"snapshot_name\": \"$snapshot_name\",
        \"snapshot_dir\": \"$snapshot_dir\",
        \"created_at\": \"$created_at\"
    }"
    
    if [[ "$verbose" == true ]] || [[ "$dry_run" == true ]]; then
        echo "Restoring snapshot: $snapshot_name"
        echo "Created at: $created_at"
        echo "Files to restore: $captured_files"
        echo "Snapshot path: $snapshot_dir"
        echo ""
    fi
    
    if [[ "$dry_run" == true ]]; then
        echo "Dry run - would restore these files:"
        for file in "${snapshot_dir}"/*; do
            if [[ -f "$file" ]] && [[ "$(basename "$file")" != "metadata.json" ]]; then
                echo "  $(basename "$file") → ${out_dir}/$(basename "$file")"
            fi
        done
        return 0
    fi
    
    # Create backup of current state before restore
    local backup_dir="${out_dir}/backup_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$backup_dir"
    
    # Backup current files
    local backed_up_files=0
    for file in "${out_dir}"/*.jsonl "${out_dir}"/*.tsv "${out_dir}"/*.json "${out_dir}/state.db" "${out_dir}/events.jsonl" "${out_dir}/audit.log"; do
        if [[ -f "$file" ]]; then
            cp "$file" "$backup_dir/" 2>/dev/null && backed_up_files=$((backed_up_files + 1))
        fi
    done
    
    if [[ $backed_up_files -gt 0 ]]; then
        [[ "$verbose" == true ]] && echo "Current state backed up to: $backup_dir ($backed_up_files files)"
    fi
    
    # Restore files from snapshot
    local restored_files=0
    for file in "${snapshot_dir}"/*; do
        if [[ -f "$file" ]] && [[ "$(basename "$file")" != "metadata.json" ]]; then
            local dest_file="${out_dir}/$(basename "$file")"
            cp "$file" "$dest_file"
            restored_files=$((restored_files + 1))
            [[ "$verbose" == true ]] && echo "  ✓ Restored $(basename "$file")"
        fi
    done
    
    emit_event "snapshot_restore_completed" "{
        \"snapshot_name\": \"$snapshot_name\",
        \"restored_files\": $restored_files,
        \"backup_dir\": \"$backup_dir\"
    }"
    
    echo "Snapshot restored: $snapshot_name"
    echo "Files restored: $restored_files"
    if [[ $backed_up_files -gt 0 ]]; then
        echo "Previous state backed up to: $backup_dir"
    fi
}

# List available processing state snapshots
snapshot_list() {
    local out_dir=".sourceatlas"
    local verbose=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} snapshot list [options]

List all available processing state snapshots.

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --verbose, -v    Show detailed information
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} snapshot list
  ${PROG_NAME} snapshot list --verbose
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
    
    local snapshots_dir="${out_dir}/snapshots"
    
    if [[ ! -d "$snapshots_dir" ]]; then
        echo "No snapshots found (directory does not exist: $snapshots_dir)"
        return 0
    fi
    
    local snapshot_count=0
    
    echo "Available snapshots:"
    echo "==================="
    
    for snapshot_dir in "${snapshots_dir}"/*; do
        if [[ -d "$snapshot_dir" ]]; then
            local snapshot_name=$(basename "$snapshot_dir")
            snapshot_count=$((snapshot_count + 1))
            
            if [[ -f "${snapshot_dir}/metadata.json" ]]; then
                local metadata_json=$(cat "${snapshot_dir}/metadata.json")
                local created_at=$(echo "$metadata_json" | grep -o '"created_at": "[^"]*"' | cut -d'"' -f4 | sed 's/T/ /' | sed 's/Z$//')
                local captured_files=$(echo "$metadata_json" | grep -o '"captured_files": [0-9]*' | cut -d':' -f2 | tr -d ' ')
                
                if [[ "$verbose" == true ]]; then
                    local working_dir=$(echo "$metadata_json" | grep -o '"working_directory": "[^"]*"' | cut -d'"' -f4)
                    local version=$(echo "$metadata_json" | grep -o '"version": "[^"]*"' | cut -d'"' -f4)
                    
                    echo "$snapshot_name"
                    echo "  Created: $created_at"
                    echo "  Files: $captured_files"
                    echo "  Directory: $working_dir"
                    echo "  Version: $version"
                    echo ""
                else
                    printf "%-30s %s (%s files)\\n" "$snapshot_name" "$created_at" "$captured_files"
                fi
            else
                echo "$snapshot_name (corrupted - missing metadata)"
            fi
        fi
    done
    
    if [[ $snapshot_count -eq 0 ]]; then
        echo "No snapshots found in $snapshots_dir"
    else
        echo ""
        echo "Total snapshots: $snapshot_count"
    fi
}

# Command: health
cmd_health() {
    local out_dir=".sourceatlas"
    local verbose=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} health [options]

Show system health status including circuit breaker states and recent failures.

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --verbose, -v    Show detailed information
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} health
  ${PROG_NAME} health --verbose
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
    
    echo "SourceAtlas System Health Report"
    echo "================================="
    echo ""
    
    local overall_health="HEALTHY"
    
    # Check circuit breaker status
    echo "Circuit Breaker Status:"
    echo "-----------------------"
    
    local cb_status_json=$(get_circuit_breaker_status "$out_dir")
    if [[ "$cb_status_json" == "[]" ]]; then
        echo "No circuit breakers initialized"
    else
        # Parse and display circuit breaker status
        while IFS='|' read -r operation state failure_count success_count last_failure last_success opened_at; do
            # Skip comments and empty lines
            [[ "$operation" =~ ^#.*$ ]] || [[ -z "$operation" ]] && continue
            
            case "$state" in
                "OPEN")
                    echo "  ❌ $operation: $state (failures: $failure_count)"
                    overall_health="DEGRADED"
                    ;;
                "HALF_OPEN")
                    echo "  ⚠️  $operation: $state (failures: $failure_count, testing recovery)"
                    [[ "$overall_health" == "HEALTHY" ]] && overall_health="RECOVERING"
                    ;;
                "CLOSED")
                    echo "  ✅ $operation: $state (failures: $failure_count, successes: $success_count)"
                    ;;
                *)
                    echo "  ❓ $operation: $state (unknown state)"
                    [[ "$overall_health" == "HEALTHY" ]] && overall_health="UNKNOWN"
                    ;;
            esac
        done < "$out_dir/circuit_breaker.db"
        
        # Update overall health based on circuit breaker states
        if grep -q "|OPEN|" "$out_dir/circuit_breaker.db" 2>/dev/null; then
            overall_health="DEGRADED"
        elif grep -q "|HALF_OPEN|" "$out_dir/circuit_breaker.db" 2>/dev/null; then
            [[ "$overall_health" == "HEALTHY" ]] && overall_health="RECOVERING"
        fi
    fi
    
    echo ""
    
    # Check file system status
    echo "File System Status:"
    echo "-------------------"
    
    if [[ -d "$out_dir" ]]; then
        echo "  ✅ Output directory: $out_dir (exists)"
        
        # Check key files
        local key_files=("state.db" "circuit_breaker.db" "events.jsonl" "audit.log" "lineage.jsonl")
        for file in "${key_files[@]}"; do
            if [[ -f "$out_dir/$file" ]]; then
                local size=$(stat -f%z "$out_dir/$file" 2>/dev/null || stat -c%s "$out_dir/$file" 2>/dev/null || echo "unknown")
                echo "  ✅ $file: exists ($size bytes)"
            else
                echo "  ⚠️  $file: missing"
                [[ "$overall_health" == "HEALTHY" ]] && overall_health="DEGRADED"
            fi
        done
    else
        echo "  ❌ Output directory: $out_dir (does not exist)"
        overall_health="DEGRADED"
    fi
    
    echo ""
    
    # Show overall health
    echo "Overall System Health: $overall_health"
    case "$overall_health" in
        "HEALTHY")
            echo "  ✅ All systems operational"
            ;;
        "RECOVERING")
            echo "  ⚠️  System recovering from failures"
            ;;
        "DEGRADED")
            echo "  ❌ System experiencing issues"
            ;;
        "UNKNOWN")
            echo "  ❓ System status unclear"
            ;;
    esac
    
    if [[ "$verbose" == true ]]; then
        echo ""
        echo "Detailed Circuit Breaker Information:"
        echo "====================================="
        echo "$cb_status_json" | python3 -m json.tool 2>/dev/null || echo "$cb_status_json"
    fi
    
    # Exit with appropriate code
    case "$overall_health" in
        "HEALTHY"|"RECOVERING") exit 0 ;;
        *) exit 1 ;;
    esac
}

# Command: lineage
cmd_lineage() {
    local subcommand="${1:-}"
    
    case "$subcommand" in
        query)
            shift
            lineage_query "$@"
            ;;
        stats)
            shift
            lineage_stats "$@"
            ;;
        trace)
            shift
            lineage_trace "$@"
            ;;
        --help|-h|"")
            cat <<EOF
Usage: ${PROG_NAME} lineage <subcommand> [options]

Query and analyze data lineage for comprehensive data flow understanding.

Subcommands:
  query <entity>       Query lineage for a specific entity
  stats               Show lineage statistics
  trace <start> <end> Trace lineage path between entities

Examples:
  ${PROG_NAME} lineage query ./src/main.swift
  ${PROG_NAME} lineage stats --verbose
  ${PROG_NAME} lineage trace ./input.swift ./output.jsonl
EOF
            exit 0
            ;;
        *)
            echo "Error: Unknown lineage subcommand: $subcommand" >&2
            echo "Run '${PROG_NAME} lineage --help' for usage." >&2
            exit 1
            ;;
    esac
}

# Query lineage for entity
lineage_query() {
    local entity="$1"
    local out_dir=".sourceatlas"
    local direction="both"
    local verbose=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --direction)
                direction="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} lineage query <entity> [options]

Query lineage relationships for a specific entity.

Arguments:
  entity           Entity to query (file path, symbol name, etc.)

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --direction DIR  Query direction: upstream, downstream, both (default: both)
  --verbose, -v    Show detailed lineage information
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} lineage query ./src/main.swift
  ${PROG_NAME} lineage query MainViewModel --direction upstream
  ${PROG_NAME} lineage query ./output.jsonl --verbose
EOF
                exit 0
                ;;
            --*)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
            *)
                if [[ -z "$entity" ]]; then
                    entity="$1"
                else
                    echo "Error: Unexpected argument: $1" >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done
    
    if [[ -z "$entity" ]]; then
        echo "Error: Entity name required" >&2
        echo "Run '${PROG_NAME} lineage query --help' for usage." >&2
        exit 1
    fi
    
    export LINEAGE_FILE="$out_dir/lineage.jsonl"
    
    echo "Lineage Query Results for: $entity"
    echo "=================================="
    echo "Direction: $direction"
    echo ""
    
    local results=$(query_lineage_by_entity "$entity" "$direction")
    
    if [[ -z "$results" ]]; then
        echo "No lineage relationships found for '$entity'"
        return 0
    fi
    
    local count=0
    echo "$results" | while IFS= read -r line; do
        if [[ -n "$line" ]]; then
            count=$((count + 1))
            
            if [[ "$verbose" == "true" ]]; then
                echo "Record $count:"
                echo "$line" | python3 -m json.tool 2>/dev/null || echo "$line"
                echo ""
            else
                # Extract key information for summary display
                local event_type=$(echo "$line" | grep -o '"event_type": "[^"]*"' | cut -d'"' -f4)
                local operation=$(echo "$line" | grep -o '"operation": "[^"]*"' | cut -d'"' -f4)
                local source=$(echo "$line" | grep -o '"source"[^}]*"entity": "[^"]*"' | tail -1 | cut -d'"' -f4)
                local target=$(echo "$line" | grep -o '"target"[^}]*"entity": "[^"]*"' | tail -1 | cut -d'"' -f4)
                local timestamp=$(echo "$line" | grep -o '"timestamp": "[^"]*"' | cut -d'"' -f4)
                
                printf "%s [%s] %s → %s (%s)\\n" "$timestamp" "$event_type" "$source" "$target" "$operation"
            fi
        fi
    done
}

# Show lineage statistics
lineage_stats() {
    local out_dir=".sourceatlas"
    local verbose=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} lineage stats [options]

Show comprehensive lineage statistics and analytics.

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --verbose, -v    Show detailed breakdown
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} lineage stats
  ${PROG_NAME} lineage stats --verbose
EOF
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
        esac
    done
    
    echo "Data Lineage Statistics"
    echo "======================="
    echo ""
    
    local stats=$(get_lineage_stats "$out_dir")
    local total_events=$(echo "$stats" | grep -o '"total_events": [0-9]*' | cut -d':' -f2 | tr -d ' ')
    local unique_entities=$(echo "$stats" | grep -o '"entities": [0-9]*' | cut -d':' -f2 | tr -d ' ')
    local unique_operations=$(echo "$stats" | grep -o '"operations": [0-9]*' | cut -d':' -f2 | tr -d ' ')
    
    echo "Overall Statistics:"
    echo "  Total Events: $total_events"
    echo "  Unique Entities: $unique_entities"
    echo "  Unique Operations: $unique_operations"
    
    if [[ -f "$out_dir/lineage.jsonl" ]]; then
        local file_size=$(stat -f%z "$out_dir/lineage.jsonl" 2>/dev/null || stat -c%s "$out_dir/lineage.jsonl" 2>/dev/null || echo 0)
        echo "  Lineage File Size: $file_size bytes"
    fi
    
    if [[ "$verbose" == "true" ]]; then
        echo ""
        echo "Operation Breakdown:"
        grep -o '"operation": "[^"]*"' "$out_dir/lineage.jsonl" 2>/dev/null | sort | uniq -c | sort -nr | while read count op; do
            operation=$(echo "$op" | cut -d'"' -f4)
            echo "  $operation: $count events"
        done
        
        echo ""
        echo "Event Type Breakdown:"
        grep -o '"event_type": "[^"]*"' "$out_dir/lineage.jsonl" 2>/dev/null | sort | uniq -c | sort -nr | while read count type; do
            event_type=$(echo "$type" | cut -d'"' -f4)
            echo "  $event_type: $count events"
        done
        
        echo ""
        echo "Entity Type Breakdown:"
        grep -o '"type": "[^"]*"' "$out_dir/lineage.jsonl" 2>/dev/null | sort | uniq -c | sort -nr | while read count type; do
            entity_type=$(echo "$type" | cut -d'"' -f4)
            echo "  $entity_type: $count references"
        done
    fi
}

# Trace lineage path
lineage_trace() {
    local start_entity="$1"
    local end_entity="$2"
    local out_dir=".sourceatlas"
    local max_depth=10
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out)
                out_dir="$2"
                shift 2
                ;;
            --max-depth)
                max_depth="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: ${PROG_NAME} lineage trace <start> <end> [options]

Trace lineage path between two entities.

Arguments:
  start            Starting entity
  end              Target entity

Options:
  --out DIR        Output directory (default: .sourceatlas)
  --max-depth NUM  Maximum search depth (default: 10)
  --help, -h       Show this help message

Examples:
  ${PROG_NAME} lineage trace ./input.swift ./output.jsonl
  ${PROG_NAME} lineage trace MainViewModel symbols_table --max-depth 5
EOF
                exit 0
                ;;
            --*)
                echo "Error: Unknown option: $1" >&2
                exit 1
                ;;
            *)
                if [[ -z "$start_entity" ]]; then
                    start_entity="$1"
                elif [[ -z "$end_entity" ]]; then
                    end_entity="$1"
                else
                    echo "Error: Unexpected argument: $1" >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done
    
    if [[ -z "$start_entity" || -z "$end_entity" ]]; then
        echo "Error: Both start and end entities required" >&2
        echo "Run '${PROG_NAME} lineage trace --help' for usage." >&2
        exit 1
    fi
    
    export LINEAGE_FILE="$out_dir/lineage.jsonl"
    
    echo "Tracing Lineage Path"
    echo "==================="
    echo "From: $start_entity"
    echo "To:   $end_entity"
    echo "Max Depth: $max_depth"
    echo ""
    
    local result=$(trace_lineage_path "$start_entity" "$end_entity" "$max_depth")
    local path_found=$(echo "$result" | grep -o '"path_found": [^,}]*' | cut -d':' -f2 | tr -d ' ')
    local depth=$(echo "$result" | grep -o '"depth": [^,}]*' | cut -d':' -f2 | tr -d ' ')
    
    if [[ "$path_found" == "true" ]]; then
        echo "✅ Path found!"
        echo "   Depth: $depth steps"
    else
        echo "❌ No path found"
        echo "   Searched depth: $depth steps"
        echo "   Try increasing --max-depth or check if entities are connected"
    fi
}

# Main entry point
main() {
    local command="${1:-}"
    local session_start_time=$(get_timestamp_ms)
    
    # Initialize event system early
    init_event_system
    
    # Initialize state machine database
    init_state_db
    
    # Initialize circuit breaker database
    init_circuit_breaker_db
    
    # Initialize lineage tracking
    init_lineage_tracking
    
    # Build args array safely
    local args_json="[]"
    if [[ $# -gt 0 ]]; then
        args_json="[$(printf '"%s",' "$@" | sed 's/,$//' | sed 's/"/\\"/g')]"
    fi
    
    # Emit session start event
    emit_event "session_started" "{
        \"command\": \"$command\",
        \"args\": $args_json,
        \"version\": \"$VERSION\",
        \"schema_version\": \"$SCHEMA_VERSION\"
    }"
    
    # Start main span
    start_span "main_command_$command"
    
    local exit_code=0
    case "$command" in
        version|--version|-v)
            track_performance "show_version" show_version || exit_code=$?
            ;;
        help|--help|-h|"")
            track_performance "show_help" show_help || exit_code=$?
            ;;
        init)
            shift
            track_performance "cmd_init" cmd_init "$@" || exit_code=$?
            ;;
        scan)
            shift
            track_performance "cmd_scan" cmd_scan "$@" || exit_code=$?
            ;;
        symbols)
            shift
            track_performance "cmd_symbols" cmd_symbols "$@" || exit_code=$?
            ;;
        stats)
            shift
            track_performance "cmd_stats" cmd_stats "$@" || exit_code=$?
            ;;
        manifest)
            shift
            track_performance "cmd_manifest" cmd_manifest "$@" || exit_code=$?
            ;;
        shard)
            shift
            track_performance "cmd_shard" cmd_shard "$@" || exit_code=$?
            ;;
        delta)
            shift
            track_performance "cmd_delta" cmd_delta "$@" || exit_code=$?
            ;;
        query)
            shift
            track_performance "cmd_query" cmd_query "$@" || exit_code=$?
            ;;
        segment)
            shift
            track_performance "cmd_segment" cmd_segment "$@" || exit_code=$?
            ;;
        export-dsl)
            shift
            track_performance "cmd_export_dsl" cmd_export_dsl "$@" || exit_code=$?
            ;;
        clean)
            shift
            track_performance "cmd_clean" cmd_clean "$@" || exit_code=$?
            ;;
        run)
            shift
            track_performance "cmd_run" cmd_run "$@" || exit_code=$?
            ;;
        verify)
            shift
            track_performance "cmd_verify" cmd_verify "$@" || exit_code=$?
            ;;
        snapshot)
            shift
            track_performance "cmd_snapshot" cmd_snapshot "$@" || exit_code=$?
            ;;
        health)
            shift
            track_performance "cmd_health" cmd_health "$@" || exit_code=$?
            ;;
        lineage)
            shift
            track_performance "cmd_lineage" cmd_lineage "$@" || exit_code=$?
            ;;
        *)
            emit_event "command_error" "{
                \"error\": \"unknown_command\",
                \"command\": \"$command\",
                \"message\": \"Unknown command: $command\"
            }"
            echo "Error: Unknown command: $command" >&2
            echo "Run '${PROG_NAME} help' for usage information." >&2
            exit_code=1
            ;;
    esac
    
    # End main span and emit session end event
    end_span "main_command_$command" "$exit_code"
    
    local session_end_time=$(get_timestamp_ms)
    local duration_ms=$((session_end_time - session_start_time))
    
    emit_event "session_ended" "{
        \"command\": \"$command\",
        \"exit_code\": $exit_code,
        \"duration_ms\": $duration_ms
    }"
    
    exit $exit_code
}

# Run main function
main "$@"